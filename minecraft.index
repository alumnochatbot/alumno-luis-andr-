<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voxel Engine v15.0 - El Nether e Inframundo</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        body { margin: 0; overflow: hidden; background-color: #a3d1ff; font-family: 'Segoe UI', sans-serif; }
        #ui {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            pointer-events: none;
            z-index: 10;
        }
        .stats { background: rgba(0,0,0,0.6); padding: 12px 20px; border-radius: 15px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); }
        
        #health-ui {
            position: absolute;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            width: 250px;
            height: 25px;
            background: rgba(0,0,0,0.6);
            border: 2px solid #fff;
            border-radius: 5px;
            overflow: hidden;
            z-index: 15;
        }
        #health-bar {
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, #ff3333, #aa0000);
            transition: width 0.2s ease;
        }
        .creative-health {
            background: linear-gradient(90deg, #ffcc00, #ffaa00) !important;
            box-shadow: 0 0 15px #ffaa00;
        }

        #crosshair {
            position: absolute;
            top: 50%; left: 50%;
            width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,0.8);
            transform: translate(-50%, -50%);
            pointer-events: none;
            border-radius: 50%;
        }
        
        #inventory {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            background: rgba(0,0,0,0.6);
            padding: 10px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            z-index: 10;
        }
        .slot {
            width: 45px; height: 45px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 12px;
            background: rgba(255,255,255,0.1);
            transition: all 0.3s ease;
            font-size: 20px;
            border: 2px solid transparent;
            color: white;
            position: relative;
            cursor: pointer;
        }
        .slot.active {
            background: rgba(255,255,255,0.3);
            border-color: #fff;
            transform: scale(1.15) translateY(-5px);
        }
        .slot.locked {
            opacity: 0.3;
            filter: grayscale(100%);
        }
        .qty {
            position: absolute;
            bottom: 2px;
            right: 5px;
            font-size: 10px;
            font-weight: bold;
            text-shadow: 1px 1px 0 #000;
        }

        #cycle-info {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(0,0,0,0.5);
            color: white;
            padding: 10px 15px;
            border-radius: 10px;
            font-weight: bold;
            text-align: right;
        }
        #mode-badge {
            background: #ffcc00; color: black; padding: 2px 8px; border-radius: 4px;
            font-size: 12px; margin-top: 5px; display: inline-block;
        }

        #notification {
            position: absolute;
            top: 60%; left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-weight: bold;
            font-size: 24px;
            text-shadow: 2px 2px 0 #000;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 20;
        }

        #crafting-menu {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 15, 20, 0.95);
            border: 2px solid #44ffaa;
            border-radius: 12px;
            padding: 25px;
            color: white;
            display: none;
            z-index: 50;
            backdrop-filter: blur(10px);
            width: 400px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }
        .recipe {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 15px; padding: 10px; background: rgba(255,255,255,0.05);
            border-radius: 8px;
        }
        .recipe button {
            background: #44ffaa; color: #000; border: none; padding: 8px 12px; 
            border-radius: 6px; cursor: pointer; font-weight: bold; font-family: 'Segoe UI';
            transition: 0.2s;
        }
        .recipe button:hover { background: #33ee99; }
        .recipe button:disabled { background: #444; color: #888; cursor: not-allowed; }

        #large-inventory-menu {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(25, 25, 35, 0.95);
            border: 2px solid #ffd700;
            border-radius: 15px;
            padding: 25px;
            color: white;
            display: none;
            z-index: 60;
            backdrop-filter: blur(12px);
            width: 500px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.9);
        }
        .inv-grid {
            display: grid;
            grid-template-columns: repeat(9, 1fr);
            gap: 8px;
            margin-top: 15px;
            margin-bottom: 20px;
        }
        .inv-item-slot {
            width: 46px;
            height: 46px;
            background: rgba(255, 255, 255, 0.08);
            border: 2px solid #555;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            cursor: pointer;
            position: relative;
            transition: all 0.2s;
        }
        .inv-item-slot:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: #ffd700;
            transform: scale(1.08);
        }
        .inv-item-slot .qty-lbl {
            position: absolute;
            bottom: 2px;
            right: 4px;
            font-size: 10px;
            font-weight: bold;
            text-shadow: 1px 1px 0 #000;
        }
        .inv-item-slot.locked-item {
            opacity: 0.3;
            cursor: not-allowed;
        }

        #damage-flash {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(255, 0, 0, 0);
            pointer-events: none;
            z-index: 100;
            transition: background 0.1s;
        }

        #portal-flash {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(128, 0, 128, 0);
            pointer-events: none;
            z-index: 101;
            transition: background 0.1s;
        }

        #grave-hud {
            position: absolute;
            top: 100px;
            right: 20px;
            background: rgba(0, 0, 0, 0.7);
            color: #ff3333;
            border: 1px dashed #ff3333;
            padding: 10px 15px;
            border-radius: 8px;
            font-size: 13px;
            display: none;
            z-index: 10;
        }
    </style>
</head>
<body>

    <div id="damage-flash"></div>
    <div id="portal-flash"></div>
    
    <div id="ui">
        <div class="stats">
            <b style="color: #da44ff;">Voxel Engine v15.0 - Multidimensional</b><br>
            • <b>1 al 9</b>: Seleccionar objeto | <b>I</b>: Inventario Completo 🎒<br>
            • <b>E</b>: Forja y Crafteos ⚒️ | <b>H</b>: Música 🎵<br>
            • <b>G</b>: Modo Juego | <b>V</b>: Vuelo | <b>Z</b>: Deshacer Bloque<br>
            • <b>Nether:</b> Marco de 4x5 Obsidiana + Esquero 🔥<br>
            • <b>End:</b> Anillo 3x3 de Marcos del End + Clic con Ojo de Ender 👁️<br>
            <div id="mode-display" style="font-weight: bold; margin-top: 5px;">Modo: Supervivencia</div>
            <div id="dimension-display" style="font-weight: bold; color: #55ffaa; margin-top: 3px;">Mundo: Overworld</div>
        </div>
    </div>
    
    <div id="cycle-info">
        <div id="time-text">Día - 00:00</div>
        <div id="mode-badge" style="display:none;">INVENCIBLE</div>
    </div>

    <div id="grave-hud">
        ⏳ Tumba activa: <span id="grave-timer">60s</span> restante<br>
        <span style="font-size: 10px; color: #ccc;">Regresa rápido a donde moriste.</span>
    </div>
    
    <div id="health-ui"><div id="health-bar"></div></div>
    <div id="notification"></div>
    <div id="crosshair"></div>
    
    <div id="inventory">
        <div id="slot-1" class="slot active" onclick="selectSlotByClick(1)">🌿<span class="qty">∞</span></div>
        <div id="slot-2" class="slot" onclick="selectSlotByClick(2)">🪨<span class="qty" id="qty-stone">0</span></div>
        <div id="slot-3" class="slot" onclick="selectSlotByClick(3)">🪵<span class="qty" id="qty-wood">0</span></div>
        <div id="slot-4" class="slot" onclick="selectSlotByClick(4)">⛓️<span class="qty" id="qty-iron">0</span></div>
        <div id="slot-5" class="slot" onclick="selectSlotByClick(5)">🧨<span class="qty" id="qty-tnt">0</span></div>
        <div id="slot-6" class="slot" onclick="selectSlotByClick(6)">⬛<span class="qty" id="qty-obsidian">0</span></div>
        <div id="slot-7" class="slot locked" onclick="selectSlotByClick(7)">⛏️<span id="pick-tier" style="font-size:9px; display:block;">Ninguno</span></div>
        <div id="slot-8" class="slot locked" onclick="selectSlotByClick(8)">⚔️<span id="sword-tier" style="font-size:9px; display:block;">Ninguno</span></div>
        <div id="slot-9" class="slot locked" onclick="selectSlotByClick(9)">🔥<span style="font-size:9px; display:block;">Esquero</span></div>
    </div>

    <div id="crafting-menu">
        <h2 style="margin-top:0; text-align:center; color:#44ffaa;">Forja y Crafteo</h2>
        <div id="craft-res" style="margin-bottom:20px; font-size:12px; color:#ccc; text-align:center; background: rgba(0,0,0,0.5); padding: 10px; border-radius: 8px;">
            Recursos: Madera (0) | Hierro (0) | Oro (0) | Diamante (0)
        </div>
        
        <div class="recipe">
            <div><b>Tablones (No usables)</b> 🟫<br><span style="font-size:11px; color:#aaa;">Costo: 1 Madera</span></div>
            <button onclick="craft('planks')">Craftear x4</button>
        </div>

        <h3 style="color:#44ffaa; border-bottom: 1px solid #444; margin-top: 20px;">Artículos Especiales</h3>
        
        <div class="recipe">
            <div><b>Ojo de Ender</b> 👁️<br><span style="font-size:11px; color:#aaa;">Costo: 1 Oro, 1 P. Luminosa</span></div>
            <button onclick="craft('eye_of_ender')">Craftear x1</button>
        </div>

        <div class="recipe">
            <div><b>Marco del End</b> 🟩<br><span style="font-size:11px; color:#aaa;">Costo: 3 Piedra, 1 Obsidiana</span></div>
            <button onclick="craft('end_portal_frame')">Craftear x1</button>
        </div>

        <div class="recipe">
            <div><b>Esquero / Encendedor</b> 🔥<br><span style="font-size:11px; color:#aaa;">Costo: 1 Hierro, 1 Piedra</span></div>
            <button id="btn-craft-flint" onclick="craftFlintAndSteel()">Craftear</button>
        </div>

        <div class="recipe">
            <div><b>Bloque de TNT</b> 🧨<br><span style="font-size:11px; color:#aaa;">Costo: 3 Carbón, 3 Piedra</span></div>
            <button id="btn-craft-tnt" onclick="craftTNT()">Craftear</button>
        </div>

        <h3 style="color:#44ffaa; border-bottom: 1px solid #444; margin-top: 20px;">Mejoras de Equipo</h3>
        
        <div class="recipe">
            <div><b id="txt-pick-upgrade">Pico de Madera</b> ⛏️<br><span id="cost-pick-upgrade" style="font-size:11px; color:#aaa;">Costo: 3 Madera</span></div>
            <button id="btn-upgrade-pick" onclick="upgradeItem('pickaxe')">Mejorar</button>
        </div>

        <div class="recipe">
            <div><b id="txt-sword-upgrade">Espada de Madera</b> ⚔️<br><span id="cost-sword-upgrade" style="font-size:11px; color:#aaa;">Costo: 1 Madera, 2 Piedra</span></div>
            <button id="btn-upgrade-sword" onclick="upgradeItem('sword')">Mejorar</button>
        </div>
        
        <button onclick="toggleCrafting()" style="width: 100%; background: #f44336; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px;">Cerrar Menú</button>
    </div>

    <div id="large-inventory-menu">
        <h2 style="margin-top:0; text-align:center; color:#ffd700;">Inventario del Jugador 🎒</h2>
        <p style="font-size: 11px; color: #bbb; text-align: center; margin-top: -8px;">Haz clic en un objeto para asignarlo al Hotbar seleccionado.</p>
        <div class="inv-grid" id="large-inventory-grid"></div>
        <button onclick="toggleLargeInventory()" style="width: 100%; background: #ffd700; color: #111; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer;">Cerrar Inventario</button>
    </div>

    <audio id="drive-audio-player" loop style="display:none;"></audio>

    <script>
        let scene, camera, renderer, player;
        let worldData = new Map(); 
        let overworldData = new Map();
        let netherData = new Map();
        let endData = new Map();
        let currentDimension = "overworld"; // "overworld", "nether", o "end"

        const VIEW_DISTANCE = 30; 
        const WATER_LEVEL = 7;
        const LAVA_LEVEL = 3;
        let keys = {};
        let velocity = new THREE.Vector3();
        let selectedSlot = 1;
        let isThirdPerson = false;
        
        let health = 100;
        let gameTime = 0; 
        let isNight = false;
        const mobs = [];
        let activeArrows = []; 
        let activeTnts = []; 
        let respawnTimer = 0; 
        let pigmenAngered = false;
        let pigmenAngerTimer = 0;
        
        let pitch = 0, yaw = 0;   
        let audioStarted = false;

        let isCreative = false; 
        let isFlying = false;
        let resources = { 
            wood: 0, stone: 0, iron: 0, gold: 0, diamond: 0, 
            planks: 0, arrows: 0, grass: Infinity, coal: 0, emerald: 0, apple: 0, meat: 0,
            beef: 0, chicken_meat: 0, mutton: 0,
            obsidian: 0, tnt: 0,
            netherrack: 0, soulsand: 0, glowstone: 0, quartz: 0, nether_brick: 0,
            end_stone: 0, eye_of_ender: 0, end_portal_frame: 0
        };
        let history = []; 

        let pickaxeLevel = 0; 
        let swordLevel = 0;
        let hasBow = false; 
        let hasFlintAndSteel = false; 
        let teleporting = false;
        let portalTimer = 0;

        const tiers = [
            { name: "Ninguno", cost: null },
            { name: "Madera", cost: { wood: 3 }, power: 1 },
            { name: "Hierro", cost: { iron: 3 }, power: 2 },
            { name: "Oro", cost: { gold: 3 }, power: 3 },
            { name: "Diamante", cost: { diamond: 3 }, power: 5 }
        ];

        let isCraftingOpen = false;
        let isLargeInventoryOpen = false;

        let deathChest = {
            active: false, mesh: null, timer: 0, resources: null, position: new THREE.Vector3()
        };

        const geometry = new THREE.BoxGeometry(1, 1, 1);
        const tntFlashMat = new THREE.MeshBasicMaterial({ color: 0xffffff }); 
        
        let slotToType = { 
            1: "grass", 2: "stone", 3: "wood", 4: "iron", 5: "tnt", 6: "obsidian", 7: "pickaxe", 8: "sword", 9: "flint_and_steel" 
        };

        const itemMetaData = {
            grass: { name: "Césped", emoji: "🌿", resourceName: "grass" },
            stone: { name: "Piedra", emoji: "🪨", resourceName: "stone" },
            wood: { name: "Madera", emoji: "🪵", resourceName: "wood" },
            iron: { name: "Hierro", emoji: "⛓️", resourceName: "iron" },
            gold: { name: "Oro", emoji: "📀", resourceName: "gold" },
            diamond: { name: "Diamante", emoji: "💎", resourceName: "diamond" },
            obsidian: { name: "Obsidiana", emoji: "⬛", resourceName: "obsidian" },
            tnt: { name: "TNT", emoji: "🧨", resourceName: "tnt" },
            netherrack: { name: "Netherrack", emoji: "🧱", resourceName: "netherrack" },
            soulsand: { name: "Arena de Almas", emoji: "⏳", resourceName: "soulsand" },
            glowstone: { name: "Piedra Luminosa", emoji: "🟡", resourceName: "glowstone" },
            quartz: { name: "Mineral de Cuarzo", emoji: "🤍", resourceName: "quartz" },
            flint_and_steel: { name: "Esquero", emoji: "🔥", resourceName: null, isTool: true },
            end_stone: { name: "Piedra del End", emoji: "🌕", resourceName: "end_stone" },
            end_portal_frame: { name: "Marco del Portal", emoji: "🟩", resourceName: "end_portal_frame" },
            eye_of_ender: { name: "Ojo de Ender", emoji: "👁️", resourceName: "eye_of_ender" },
            pickaxe: { name: "Pico", emoji: "⛏️", resourceName: null, isTool: true },
            sword: { name: "Espada", emoji: "⚔️", resourceName: null, isTool: true },
            bow: { name: "Arco", emoji: "🏹", resourceName: "arrows", isTool: true },
            planks: { name: "Tablones", emoji: "🟫", resourceName: "planks" },
            coal: { name: "Carbón", emoji: "⚫", resourceName: "coal" },
            emerald: { name: "Esmeralda", emoji: "💚", resourceName: "emerald" },
            apple: { name: "Manzana", emoji: "🍎", resourceName: "apple" },
            meat: { name: "Filete de Cerdo", emoji: "🥩", resourceName: "meat" },
            beef: { name: "Filete de Vaca", emoji: "🥩", resourceName: "beef" },
            chicken_meat: { name: "Pollo Crudo", emoji: "🍗", resourceName: "chicken_meat" },
            mutton: { name: "Cordero Crudo", emoji: "🍖", resourceName: "mutton" }
        };

        const foodValues = {
            apple: { name: "Manzana 🍎", heal: 15 },
            meat: { name: "Filete de Cerdo 🥩", heal: 20 },
            beef: { name: "Filete de Vaca 🥩", heal: 30 },
            chicken_meat: { name: "Pollo Crudo 🍗", heal: 15 },
            mutton: { name: "Cordero Crudo 🍖", heal: 25 }
        };

        const peacefulTypes = ['pig', 'cow', 'chicken', 'sheep'];
        const textureCache = {};
        const materialCache = new Map();

        function generateProceduralTexture(type) {
            if (textureCache[type]) return textureCache[type];

            const canvas = document.createElement('canvas');
            canvas.width = 16; canvas.height = 16;
            const ctx = canvas.getContext('2d');

            function applyClassicNoise(baseColor, speckleColors, percentage = 0.4) {
                ctx.fillStyle = baseColor;
                ctx.fillRect(0, 0, 16, 16);
                for (let x = 0; x < 16; x++) {
                    for (let y = 0; y < 16; y++) {
                        if (Math.random() < percentage) {
                            ctx.fillStyle = speckleColors[Math.floor(Math.random() * speckleColors.length)];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                }
            }

            function overlayOreClusters(colorList) {
                applyClassicNoise('#737373', ['#616161', '#525252', '#838383', '#5a5a5a'], 0.45);
                const numClusters = 4 + Math.floor(Math.random() * 3);
                for (let i = 0; i < numClusters; i++) {
                    let cx = 2 + Math.floor(Math.random() * 11);
                    let cy = 2 + Math.floor(Math.random() * 11);
                    ctx.fillStyle = colorList[Math.floor(Math.random() * colorList.length)];
                    ctx.fillRect(cx, cy, 1, 1);
                    if (Math.random() < 0.75) ctx.fillRect(cx + 1, cy, 1, 1);
                    if (Math.random() < 0.75) ctx.fillRect(cx, cy + 1, 1, 1);
                    if (Math.random() < 0.4) ctx.fillRect(cx + 1, cy + 1, 1, 1);
                    if (Math.random() < 0.3) ctx.fillRect(cx - 1, cy + 1, 1, 1);
                }
            }

            switch (type) {
                case 'stone': applyClassicNoise('#737373', ['#616161', '#525252', '#838383', '#5a5a5a'], 0.45); break;
                case 'dirt': applyClassicNoise('#866043', ['#573d26', '#9c7253', '#6b4c35'], 0.4); break;
                case 'grass_top': applyClassicNoise('#557e2d', ['#4c7028', '#639235', '#3c5a1f'], 0.4); break;
                case 'grass_side':
                    applyClassicNoise('#866043', ['#573d26', '#9c7253'], 0.35);
                    ctx.fillStyle = '#557e2d';
                    for (let x = 0; x < 16; x++) {
                        let h = 2 + Math.floor(Math.sin(x * 1.5) * 1.5 + 1.5);
                        h = Math.max(2, Math.min(6, h)); 
                        for (let y = 0; y < h; y++) {
                            ctx.fillStyle = (y === h - 1) ? '#4c7028' : (Math.random() < 0.25 ? '#639235' : '#557e2d');
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                    break;
                case 'wood_side':
                    ctx.fillStyle = '#735135'; ctx.fillRect(0, 0, 16, 16);
                    for (let x = 0; x < 16; x++) {
                        if (x % 4 === 0 || x % 4 === 3) { ctx.fillStyle = '#543b26'; ctx.fillRect(x, 0, 1, 16); }
                        for (let y = 0; y < 16; y++) {
                            if (Math.random() < 0.18) { ctx.fillStyle = '#3e2a1a'; ctx.fillRect(x, y, 1, 1); }
                        }
                    }
                    break;
                case 'wood_top':
                    ctx.fillStyle = '#d7a15c'; ctx.fillRect(0, 0, 16, 16);
                    ctx.fillStyle = '#b68344'; ctx.fillRect(2, 2, 12, 12);
                    ctx.fillStyle = '#d7a15c'; ctx.fillRect(3, 3, 10, 10);
                    ctx.fillStyle = '#b68344'; ctx.fillRect(5, 5, 6, 6);
                    ctx.fillStyle = '#8f612d'; ctx.fillRect(7, 7, 2, 2);
                    break;
                case 'planks':
                    ctx.fillStyle = '#cda05f'; ctx.fillRect(0, 0, 16, 16);
                    ctx.fillStyle = '#8b6435'; 
                    ctx.fillRect(0, 0, 16, 1); ctx.fillRect(0, 4, 16, 1); ctx.fillRect(0, 8, 16, 1); ctx.fillRect(0, 12, 16, 1);
                    ctx.fillRect(4, 0, 1, 4); ctx.fillRect(10, 4, 1, 4); ctx.fillRect(3, 8, 1, 4); ctx.fillRect(12, 12, 1, 4);
                    break;
                case 'leaves': applyClassicNoise('#145c14', ['#0f440f', '#1e751e', '#2bb12b'], 0.5); break;
                case 'coal': overlayOreClusters(['#262626', '#141414', '#0d0d0d']); break;
                case 'iron': overlayOreClusters(['#d3a484', '#b38263', '#9c6f52']); break;
                case 'gold': overlayOreClusters(['#fcee4b', '#e0b115', '#f1c40f']); break;
                case 'diamond': overlayOreClusters(['#5cd7f9', '#22d3ee', '#0891b2']); break;
                case 'emerald': overlayOreClusters(['#10b981', '#059669', '#34d399']); break;
                case 'obsidian': applyClassicNoise('#150d22', ['#0a0512', '#221435', '#2c1944', '#1a0f28'], 0.5); break;
                case 'tnt':
                    ctx.fillStyle = '#bc251b'; ctx.fillRect(0, 0, 16, 16);
                    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 5, 16, 6);
                    ctx.fillStyle = '#000000';
                    ctx.fillRect(1, 6, 3, 1); ctx.fillRect(2, 7, 1, 3);
                    ctx.fillRect(5, 6, 1, 4); ctx.fillRect(6, 7, 1, 1); ctx.fillRect(7, 6, 1, 4);
                    ctx.fillRect(9, 6, 3, 1); ctx.fillRect(10, 7, 1, 3);
                    ctx.fillStyle = '#3a0c0a';
                    for(let x=0; x<16; x+=2) { ctx.fillRect(x, 0, 1, 1); ctx.fillRect(x+1, 15, 1, 1); }
                    break;
                case 'water': applyClassicNoise('#3b82f6', ['#2563eb', '#60a5fa', '#1d4ed8'], 0.4); break;
                case 'lava': applyClassicNoise('#ea580c', ['#b91c1c', '#f97316', '#facc15'], 0.5); break;
                case 'netherrack': applyClassicNoise('#722a2a', ['#511c1c', '#893636', '#411515', '#602222'], 0.5); break;
                case 'soulsand':
                    applyClassicNoise('#49392e', ['#33271f', '#5e493c', '#2c211a'], 0.45);
                    ctx.fillStyle = '#1c1510'; ctx.fillRect(4, 3, 2, 2); ctx.fillRect(10, 3, 2, 2); ctx.fillRect(6, 8, 4, 2);
                    break;
                case 'glowstone': applyClassicNoise('#cc9e43', ['#ebd787', '#fbebad', '#b4832c', '#ebd787'], 0.5); break;
                case 'quartz':
                    applyClassicNoise('#722a2a', ['#511c1c', '#893636'], 0.4);
                    ctx.fillStyle = '#ffffff'; ctx.fillRect(3, 4, 3, 2); ctx.fillRect(10, 9, 4, 2); ctx.fillRect(7, 2, 2, 3);
                    break;
                case 'portal': applyClassicNoise('#4a0e4e', ['#7b1fa2', '#9c27b0', '#ba68c8', '#310a34'], 0.6); break;
                case 'end_stone': applyClassicNoise('#f6fabd', ['#e2e89e', '#d2d882', '#c1c770'], 0.5); break;
                case 'end_portal_frame':
                    applyClassicNoise('#557e2d', ['#4c7028'], 0.2);
                    ctx.fillStyle = '#112211'; ctx.fillRect(3,3,10,10);
                    break;
                case 'end_portal_frame_filled':
                    applyClassicNoise('#557e2d', ['#4c7028'], 0.2);
                    ctx.fillStyle = '#112211'; ctx.fillRect(3,3,10,10);
                    ctx.fillStyle = '#00ffaa'; ctx.fillRect(5,5,6,6); 
                    break;
                case 'end_portal':
                    ctx.fillStyle = '#020205'; ctx.fillRect(0,0,16,16);
                    for(let i=0; i<15; i++) {
                        ctx.fillStyle = Math.random()>0.5 ? '#ffffff' : '#aa00ff';
                        ctx.fillRect(Math.floor(Math.random()*16), Math.floor(Math.random()*16), 1, 1);
                    }
                    break;
                default: ctx.fillStyle = '#888888'; ctx.fillRect(0, 0, 16, 16);
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.minFilter = THREE.NearestFilter;
            texture.magFilter = THREE.NearestFilter;
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            textureCache[type] = texture;
            return texture;
        }

        function getMaterial(type) {
            if (materialCache.has(type)) return materialCache.get(type);
            let mats;
            if (type === "grass") {
                const side = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("grass_side") });
                const top = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("grass_top") });
                const bottom = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("dirt") });
                mats = [side, side, top, bottom, side, side];
            } else if (type === "wood") {
                const side = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("wood_side") });
                const top = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("wood_top") });
                mats = [side, side, top, top, side, side];
            } else if (["dirt", "stone", "planks", "leaves", "iron", "gold", "diamond", "coal", "obsidian", "tnt", "netherrack", "soulsand", "quartz", "end_stone", "end_portal_frame", "end_portal_frame_filled"].includes(type)) {
                const mat = new THREE.MeshLambertMaterial({ map: generateProceduralTexture(type) });
                mats = [mat, mat, mat, mat, mat, mat];
            } else if (type === "end_portal") {
                const mat = new THREE.MeshBasicMaterial({ map: generateProceduralTexture("end_portal") });
                mats = [mat, mat, mat, mat, mat, mat];
            } else if (type === "emerald") {
                const mat = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("emerald"), emissive: 0x10b981, emissiveIntensity: 0.2 });
                mats = [mat, mat, mat, mat, mat, mat];
            } else if (type === "glowstone") {
                const mat = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("glowstone"), emissive: 0xffe885, emissiveIntensity: 0.5 });
                mats = [mat, mat, mat, mat, mat, mat];
            } else if (type === "portal") {
                const mat = new THREE.MeshBasicMaterial({ map: generateProceduralTexture("portal"), transparent: true, opacity: 0.75 });
                mats = [mat, mat, mat, mat, mat, mat];
            } else if (type === "water") {
                const mat = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("water"), transparent: true, opacity: 0.65 });
                mats = [mat, mat, mat, mat, mat, mat];
            } else if (type === "lava") {
                const mat = new THREE.MeshLambertMaterial({ map: generateProceduralTexture("lava"), emissive: 0xff3300, emissiveIntensity: 0.8 });
                mats = [mat, mat, mat, mat, mat, mat];
            } else {
                const mat = new THREE.MeshLambertMaterial({ color: 0x888888 });
                mats = [mat, mat, mat, mat, mat, mat];
            }
            materialCache.set(type, mats);
            return mats;
        }

        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        let musicActive = false;
        let isUsingSynthesizer = false;

        function showNotification(text, color = "#44ffaa") {
            const el = document.getElementById("notification");
            el.innerText = text; el.style.color = color; el.style.opacity = 1;
            setTimeout(() => el.style.opacity = 0, 1500);
        }

        function playExplosionSound() {
            if (!audioStarted) return;
            const bufferSize = audioContext.sampleRate * 0.8;
            const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            const noise = audioContext.createBufferSource(); noise.buffer = buffer;
            const filter = audioContext.createBiquadFilter(); filter.type = 'lowpass';
            filter.frequency.setValueAtTime(300, audioContext.currentTime); filter.frequency.exponentialRampToValueAtTime(10, audioContext.currentTime + 0.7);
            const gain = audioContext.createGain(); gain.gain.setValueAtTime(1.5, audioContext.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.8);
            noise.connect(filter); filter.connect(gain); gain.connect(audioContext.destination); noise.start();
        }

        function playPortalSound() {
            if (!audioStarted) return;
            const osc = audioContext.createOscillator(); const gain = audioContext.createGain();
            osc.type = 'sine'; osc.frequency.setValueAtTime(80, audioContext.currentTime); osc.frequency.exponentialRampToValueAtTime(600, audioContext.currentTime + 1.5);
            gain.gain.setValueAtTime(0.01, audioContext.currentTime); gain.gain.linearRampToValueAtTime(0.15, audioContext.currentTime + 0.7); gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 1.5);
            osc.connect(gain); gain.connect(audioContext.destination); osc.start(); osc.stop(audioContext.currentTime + 1.5);
        }

        function playSparkSound() {
            if (!audioStarted) return;
            const osc = audioContext.createOscillator(); const gain = audioContext.createGain();
            osc.type = 'triangle'; osc.frequency.setValueAtTime(800, audioContext.currentTime); osc.frequency.exponentialRampToValueAtTime(1200, audioContext.currentTime + 0.05);
            gain.gain.setValueAtTime(0.04, audioContext.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.05);
            osc.connect(gain); gain.connect(audioContext.destination); osc.start(); osc.stop(audioContext.currentTime + 0.05);
        }

        function playHissSound() {
            if (!audioStarted) return;
            const bufferSize = audioContext.sampleRate * 2.0; const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
            const data = buffer.getChannelData(0); for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * 0.15;
            const noise = audioContext.createBufferSource(); noise.buffer = buffer; const gain = audioContext.createGain();
            gain.gain.setValueAtTime(0.2, audioContext.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 1.8);
            noise.connect(gain); gain.connect(audioContext.destination); noise.start();
        }

        function playBlockSound(isBreaking) {
            if (!audioStarted) return;
            const oscillator = audioContext.createOscillator(); const gainNode = audioContext.createGain();
            oscillator.type = isBreaking ? 'sine' : 'triangle'; oscillator.frequency.setValueAtTime(isBreaking ? 120 : 180, audioContext.currentTime);
            oscillator.frequency.exponentialRampToValueAtTime(10, audioContext.currentTime + 0.1); gainNode.gain.setValueAtTime(0.05, audioContext.currentTime); gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.1);
            oscillator.connect(gainNode); gainNode.connect(audioContext.destination); oscillator.start(); oscillator.stop(audioContext.currentTime + 0.1);
        }

        function playBowSound() {
            if (!audioStarted) return;
            const osc = audioContext.createOscillator(); const gain = audioContext.createGain();
            osc.type = 'triangle'; osc.frequency.setValueAtTime(350, audioContext.currentTime); osc.frequency.exponentialRampToValueAtTime(80, audioContext.currentTime + 0.15);
            gain.gain.setValueAtTime(0.08, audioContext.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.15);
            osc.connect(gain); gain.connect(audioContext.destination); osc.start(); osc.stop(audioContext.currentTime + 0.15);
        }

        function playNote(freq, startTime, duration, volume = 0.08) {
            if (!musicActive || !isUsingSynthesizer) return;
            const osc = audioContext.createOscillator(); const gain = audioContext.createGain();
            osc.type = 'sine'; osc.frequency.setValueAtTime(freq, startTime);
            gain.gain.setValueAtTime(0, startTime); gain.gain.linearRampToValueAtTime(volume, startTime + 0.1); gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
            osc.connect(gain); gain.connect(audioContext.destination); osc.start(startTime); osc.stop(startTime + duration);
        }

        function startSwedenMusic() {
            const melody = [
                {f: 392.00, d: 3}, {f: 329.63, d: 3}, {f: 261.63, d: 6}, {f: 293.66, d: 3},
                {f: 349.23, d: 3}, {f: 329.63, d: 6}, {f: 261.63, d: 3}, {f: 196.00, d: 9},
                {f: 392.00, d: 3}, {f: 440.00, d: 3}, {f: 523.25, d: 6}, {f: 493.88, d: 3},
                {f: 392.00, d: 3}, {f: 329.63, d: 6}, {f: 293.66, d: 3}, {f: 261.63, d: 9}
            ];
            function loopSweden() {
                if (!musicActive || !isUsingSynthesizer) return;
                let currentTime = audioContext.currentTime; let offset = 0;
                melody.forEach(note => { playNote(note.f, currentTime + offset, note.d, 0.06); offset += note.d * 0.9; });
                setTimeout(loopSweden, offset * 1000 + 5000);
            }
            loopSweden();
        }

        function toggleGameMusic() {
            const audioEl = document.getElementById('drive-audio-player'); musicActive = !musicActive;
            if (musicActive) {
                audioEl.src = "https://docs.google.com/uc?export=download&id=1MNNdhMFMchgv0OepJOZ82XaO5puNO2KL"; audioEl.volume = 0.45;
                audioEl.play().then(() => { isUsingSynthesizer = false; showNotification("Música de fondo: Reproduciendo 🎵", "#55ffaa");
                }).catch((err) => { isUsingSynthesizer = true; startSwedenMusic(); showNotification("Iniciando melodía de respaldo 🎹", "#ffffaa"); });
            } else {
                audioEl.pause(); isUsingSynthesizer = false; showNotification("Música Silenciada 🔇", "#ffaa55");
            }
        }

        function updateInventoryUI() {
            for (let i = 1; i <= 9; i++) {
                const slotEl = document.getElementById(`slot-${i}`);
                if (slotEl) {
                    const currentType = slotToType[i]; const meta = itemMetaData[currentType];
                    if (i === selectedSlot) slotEl.classList.add('active'); else slotEl.classList.remove('active');
                    if (meta) {
                        let isLocked = false;
                        if (meta.isTool) {
                            if (currentType === "pickaxe") isLocked = !isCreative && pickaxeLevel === 0;
                            else if (currentType === "sword") isLocked = !isCreative && swordLevel === 0;
                            else if (currentType === "bow") isLocked = !isCreative && !hasBow;
                            else if (currentType === "flint_and_steel") isLocked = !isCreative && !hasFlintAndSteel;
                        }
                        if (isLocked) {
                            slotEl.classList.add('locked');
                            if (currentType === "pickaxe") slotEl.innerHTML = `⛏️<span style="font-size:9px; display:block;">Ninguno</span>`;
                            else if (currentType === "sword") slotEl.innerHTML = `⚔️<span style="font-size:9px; display:block;">Ninguno</span>`;
                            else if (currentType === "bow") slotEl.innerHTML = `🏹<span class="qty">0</span>`;
                            else if (currentType === "flint_and_steel") slotEl.innerHTML = `🔥<span style="font-size:9px; display:block;">Bloqueado</span>`;
                        } else {
                            slotEl.classList.remove('locked');
                            if (meta.isTool) {
                                let label = meta.emoji;
                                if (currentType === "pickaxe") label += `<span id="pick-tier" style="font-size:9px; display:block;">${tiers[pickaxeLevel].name}</span>`;
                                else if (currentType === "sword") label += `<span id="sword-tier" style="font-size:9px; display:block;">${tiers[swordLevel].name}</span>`;
                                else if (currentType === "bow") label += `<span class="qty">${isCreative ? "∞" : resources.arrows}</span>`;
                                else if (currentType === "flint_and_steel") label += `<span style="font-size:9px; display:block;">Listo</span>`;
                                slotEl.innerHTML = label;
                            } else {
                                const count = isCreative ? "∞" : resources[meta.resourceName];
                                slotEl.innerHTML = `${meta.emoji}<span class="qty">${count}</span>`;
                            }
                        }
                    } else slotEl.innerHTML = "";
                }
            }
        }

        function renderLargeInventory() {
            const grid = document.getElementById('large-inventory-grid'); grid.innerHTML = ''; 
            const allItems = ['grass', 'stone', 'wood', 'coal', 'iron', 'gold', 'diamond', 'emerald', 'obsidian', 'tnt', 'planks',
                'netherrack', 'soulsand', 'glowstone', 'quartz', 'end_stone', 'end_portal_frame', 'eye_of_ender',
                'pickaxe', 'sword', 'bow', 'flint_and_steel', 'apple', 'meat', 'beef', 'chicken_meat', 'mutton'];

            for (let i = 0; i < 27; i++) {
                const itemType = allItems[i % allItems.length]; const meta = itemMetaData[itemType];
                const slotDiv = document.createElement('div'); slotDiv.className = 'inv-item-slot';

                if (meta) {
                    let count = ""; let isLocked = false;
                    if (meta.isTool) {
                        if (itemType === "pickaxe") isLocked = !isCreative && pickaxeLevel === 0;
                        else if (itemType === "sword") isLocked = !isCreative && swordLevel === 0;
                        else if (itemType === "bow") isLocked = !isCreative && !hasBow;
                        else if (itemType === "flint_and_steel") isLocked = !isCreative && !hasFlintAndSteel;
                    } else count = isCreative ? "∞" : resources[meta.resourceName];

                    if (isLocked) {
                        slotDiv.classList.add('locked-item'); slotDiv.title = `${meta.name} (No desbloqueado)`;
                    } else {
                        slotDiv.title = `Haz clic para equipar ${meta.name}`;
                        slotDiv.onclick = () => {
                            slotToType[selectedSlot] = itemType;
                            showNotification(`Equipado: ${meta.name} en ranura ${selectedSlot}`, "#ffd700");
                            playBlockSound(false); handleSlotChange(selectedSlot); updateInventoryUI(); renderLargeInventory();
                        };
                    }
                    slotDiv.innerHTML = `${meta.emoji}${count !== "" ? `<span class="qty-lbl">${count}</span>` : ''}`;
                }
                grid.appendChild(slotDiv);
            }
        }

        function toggleLargeInventory() {
            if (isCraftingOpen) toggleCrafting(); 
            isLargeInventoryOpen = !isLargeInventoryOpen;
            const menu = document.getElementById('large-inventory-menu');
            if (isLargeInventoryOpen) { document.exitPointerLock(); menu.style.display = 'block'; renderLargeInventory(); } 
            else { renderer.domElement.requestPointerLock(); menu.style.display = 'none'; }
        }

        function updateCraftingUI() {
            document.getElementById('craft-res').innerText = `Recursos: Madera (${resources.wood}) | Hierro (${resources.iron}) | Oro (${resources.gold}) | Diamante (${resources.diamond})`;
            
            const flintButton = document.getElementById('btn-craft-flint');
            flintButton.disabled = (!isCreative && (resources.iron < 1 || resources.stone < 1)) || hasFlintAndSteel;
            flintButton.innerText = hasFlintAndSteel ? "Ya obtenido" : "Craftear";

            document.getElementById('btn-craft-tnt').disabled = (!isCreative && (resources.coal < 3 || resources.stone < 3));

            if (pickaxeLevel < 4) {
                const next = tiers[pickaxeLevel + 1]; const resName = Object.keys(next.cost)[0]; const amount = next.cost[resName];
                document.getElementById('txt-pick-upgrade').innerText = `Pico de ${next.name}`; document.getElementById('cost-pick-upgrade').innerText = `Costo: ${amount} de ${resName}`;
                document.getElementById('btn-upgrade-pick').disabled = (resources[resName] < amount && !isCreative);
            } else {
                document.getElementById('txt-pick-upgrade').innerText = "Pico Máximo"; document.getElementById('btn-upgrade-pick').disabled = true;
            }

            if (swordLevel < 4) {
                const next = tiers[swordLevel + 1]; const resName = Object.keys(next.cost)[0]; const amount = next.cost[resName];
                document.getElementById('txt-sword-upgrade').innerText = `Espada de ${next.name}`; document.getElementById('cost-sword-upgrade').innerText = `Costo: ${amount} de ${resName}`;
                document.getElementById('btn-upgrade-sword').disabled = (resources[resName] < amount && !isCreative);
            } else {
                document.getElementById('txt-sword-upgrade').innerText = "Espada Máxima"; document.getElementById('btn-upgrade-sword').disabled = true;
            }
        }

        function craftFlintAndSteel() {
            if ((resources.iron >= 1 && resources.stone >= 1) || isCreative) {
                if (!isCreative) { resources.iron -= 1; resources.stone -= 1; }
                hasFlintAndSteel = true; showNotification("¡Crafteaste un Esquero! 🔥", "#ffd700"); playBlockSound(false); updateCraftingUI(); updateInventoryUI();
            }
        }

        function craftTNT() {
            if ((resources.coal >= 3 && resources.stone >= 3) || isCreative) {
                if (!isCreative) { resources.coal -= 3; resources.stone -= 3; }
                resources.tnt++; showNotification("¡Crafteaste un bloque de TNT! 🧨", "#ff4444"); playBlockSound(false); updateCraftingUI(); updateInventoryUI();
            }
        }

        function upgradeItem(type) {
            if (type === 'pickaxe' && pickaxeLevel < 4) {
                const next = tiers[pickaxeLevel + 1]; const resName = Object.keys(next.cost)[0]; const amount = next.cost[resName];
                if (resources[resName] >= amount || isCreative) {
                    if (!isCreative) resources[resName] -= amount;
                    pickaxeLevel++; showNotification(`¡Pico mejorado a ${next.name}!`, "#44ffaa"); playBlockSound(false);
                }
            } else if (type === 'sword' && swordLevel < 4) {
                const next = tiers[swordLevel + 1]; const resName = Object.keys(next.cost)[0]; const amount = next.cost[resName];
                if (resources[resName] >= amount || isCreative) {
                    if (!isCreative) resources[resName] -= amount;
                    swordLevel++; showNotification(`¡Espada mejorada a ${next.name}!`, "#44ffaa"); playBlockSound(false);
                }
            }
            updateCraftingUI(); updateInventoryUI();
        }

        function craft(item) {
            if (item === 'planks' && (resources.wood >= 1 || isCreative)) {
                if(!isCreative) resources.wood -= 1; resources.planks += 4; showNotification("+4 Tablones", "#ffffaa"); playBlockSound(false);
            }
            if (item === 'end_portal_frame' && (resources.stone >= 3 && resources.obsidian >= 1 || isCreative)) {
                if(!isCreative) { resources.stone -= 3; resources.obsidian -= 1; }
                resources.end_portal_frame++; showNotification("+1 Marco del End", "#00ffaa"); playBlockSound(false);
            }
            if (item === 'eye_of_ender' && (resources.gold >= 1 && resources.glowstone >= 1 || isCreative)) {
                if(!isCreative) { resources.gold -= 1; resources.glowstone -= 1; }
                resources.eye_of_ender++; showNotification("+1 Ojo de Ender 👁️", "#aa00ff"); playBlockSound(false);
            }
            updateCraftingUI(); updateInventoryUI();
        }

        function toggleGameMode() {
            isCreative = !isCreative; isFlying = isCreative; 
            const modeDisplay = document.getElementById('mode-display'); const healthBar = document.getElementById('health-bar'); const badge = document.getElementById('mode-badge');
            if (isCreative) {
                modeDisplay.innerText = "Modo: Creativo"; modeDisplay.style.color = "#ffcc00"; healthBar.classList.add('creative-health'); badge.style.display = 'block'; health = 100; showNotification("¡Modo Creativo!", "#ffcc00");
            } else {
                modeDisplay.innerText = "Modo: Supervivencia"; modeDisplay.style.color = "#44ffaa"; healthBar.classList.remove('creative-health'); badge.style.display = 'none'; showNotification("Modo Supervivencia", "#44ffaa");
            }
            updateInventoryUI();
        }

        function toggleCrafting() {
            if (isLargeInventoryOpen) toggleLargeInventory(); 
            isCraftingOpen = !isCraftingOpen; const menu = document.getElementById('crafting-menu');
            if (isCraftingOpen) { document.exitPointerLock(); menu.style.display = 'block'; updateCraftingUI(); } 
            else { renderer.domElement.requestPointerLock(); menu.style.display = 'none'; }
        }

        function undoAction() {
            if (history.length === 0) { showNotification("Nada que deshacer", "orange"); return; }
            const last = history.pop(); const posKey = `${last.x},${last.y},${last.z}`;
            if (last.action === "place") {
                const voxel = worldData.get(posKey); if (voxel && voxel.mesh) scene.remove(voxel.mesh);
                worldData.delete(posKey); showNotification("Deshecho: Bloque eliminado", "#ffaa55");
            } else if (last.action === "break") {
                worldData.set(posKey, { type: last.type, mesh: null }); renderWorld(); showNotification("Deshecho: Bloque restaurado", "#55aaff");
            }
        }

        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xa3d1ff);
            scene.fog = new THREE.Fog(0xa3d1ff, 25, 70);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ antialias: true }); 
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            document.body.appendChild(renderer.domElement);

            scene.add(new THREE.AmbientLight(0xffffff, 0.8));
            scene.sun = new THREE.DirectionalLight(0xffffff, 0.5);
            scene.sun.position.set(50, 100, 50);
            scene.add(scene.sun);

            createCharacter();

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight);
            });

            document.addEventListener('keydown', (e) => { 
                if (e.code === 'KeyE') { toggleCrafting(); return; }
                if (e.code === 'KeyI') { toggleLargeInventory(); return; } 
                if (e.code === 'KeyG') { toggleGameMode(); return; }
                if (e.code === 'KeyZ') { undoAction(); return; }
                if (e.code === 'KeyV' && isCreative) { isFlying = !isFlying; showNotification(isFlying ? "Vuelo: Activado" : "Vuelo: Desactivado", "#ffcc00"); return; }
                if (e.code === 'KeyH') { toggleGameMusic(); return; }
                
                let numMatched = null;
                if (e.code && e.code.startsWith('Digit')) numMatched = parseInt(e.code.replace('Digit', ''));
                else if (e.key >= '1' && e.key <= '9') numMatched = parseInt(e.key);
                if (numMatched !== null && numMatched >= 1 && numMatched <= 9) { handleSlotChange(numMatched); return; }

                keys[e.code] = true; 
                if(e.code === 'KeyC') isThirdPerson = !isThirdPerson;
            });
            document.addEventListener('keyup', (e) => { keys[e.code] = false; });
            
            document.body.addEventListener('click', (e) => {
                if (e.target.tagName === 'BUTTON' || isCraftingOpen || isLargeInventoryOpen) return; 
                renderer.domElement.requestPointerLock();
                if (audioContext.state === 'suspended') audioContext.resume();
                audioStarted = true;
            });

            document.addEventListener('mousemove', (e) => {
                if (document.pointerLockElement) {
                    yaw -= e.movementX * 0.002; pitch -= e.movementY * 0.002;
                    pitch = Math.max(-Math.PI/2 + 0.1, Math.min(Math.PI/2 - 0.1, pitch));
                    player.rotation.y = yaw;
                }
            });

            document.addEventListener('mousedown', handleAction);
            document.addEventListener('contextmenu', e => e.preventDefault());
        }

        function createCharacter() {
            player = new THREE.Group(); const skinMat = new THREE.MeshLambertMaterial({ color: 0xFFDBAC });
            const head = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.4, 0.4), skinMat); head.position.y = 1.6; player.add(head);
            const body = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.7, 0.3), new THREE.MeshLambertMaterial({ color: 0x3366ff })); body.position.y = 1.0; player.add(body);
            const rightArm = new THREE.Group(); const armMesh = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.7, 0.2), skinMat); armMesh.position.y = -0.3; rightArm.add(armMesh);

            player.toolVisuals = {
                pick: new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.7, 0.1), new THREE.MeshLambertMaterial({ color: 0x888888 })),
                sword: new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.9, 0.2), new THREE.MeshLambertMaterial({ color: 0xdddddd })),
                bow: new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.8, 0.15), new THREE.MeshLambertMaterial({ color: 0x8B4513 })),
                flint_and_steel: new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.2, 0.12), new THREE.MeshLambertMaterial({ color: 0x555555 })) 
            };
            player.toolVisuals.pick.position.set(0, -0.6, 0.2); player.toolVisuals.pick.rotation.x = Math.PI/2; player.toolVisuals.pick.visible = false;
            player.toolVisuals.sword.position.set(0, -0.6, 0.3); player.toolVisuals.sword.rotation.x = Math.PI/2; player.toolVisuals.sword.visible = false;
            player.toolVisuals.bow.position.set(0, -0.5, 0.2); player.toolVisuals.bow.visible = false;
            player.toolVisuals.flint_and_steel.position.set(0, -0.5, 0.2); player.toolVisuals.flint_and_steel.visible = false;

            rightArm.add(player.toolVisuals.pick, player.toolVisuals.sword, player.toolVisuals.bow, player.toolVisuals.flint_and_steel);
            rightArm.position.set(0.35, 1.3, 0); player.add(rightArm); player.arm = rightArm;
            player.position.set(0, 30, 0); scene.add(player); player.bodyParts = player.children;
        }

        function spawnTree(x, y, z) {
            const height = 4 + Math.floor(Math.random() * 3);
            for(let i=0; i<height; i++) worldData.set(`${x},${y+i},${z}`, { type: "wood", mesh: null });
            for(let lx=-2; lx<=2; lx++) {
                for(let ly=-2; ly<=2; ly++) {
                    for(let lz=-2; lz<=2; lz++) {
                        if(lx*lx + ly*ly + lz*lz < 5) {
                            const leafPos = `${x+lx},${y+height+ly},${z+lz}`;
                            if(!worldData.has(leafPos)) worldData.set(leafPos, { type: "leaves", mesh: null });
                        }
                    }
                }
            }
        }

