        function spawnDeathChest(pos, droppedResources) {
            removeDeathChest();
            deathChest.resources = Object.assign({}, droppedResources); deathChest.active = true; deathChest.timer = 60.0; 
            deathChest.position.copy(pos); deathChest.position.y = Math.floor(pos.y) + 0.5;

            const chestGroup = new THREE.Group(); const woodMat = new THREE.MeshLambertMaterial({ color: 0x8B4513 }); const metalMat = new THREE.MeshLambertMaterial({ color: 0xC0C0C0 }); 
            const base = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.4, 0.5), woodMat); base.position.y = 0.2; chestGroup.add(base);
            const lid = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.15, 0.5), woodMat); lid.position.y = 0.47; chestGroup.add(lid);
            const lock = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.12, 0.08), metalMat); lock.position.set(0, 0.3, 0.26); chestGroup.add(lock);
            const ring = new THREE.Mesh(new THREE.RingGeometry(0.3, 0.4, 8), new THREE.MeshBasicMaterial({ color: 0xffaa00, side: THREE.DoubleSide, transparent: true, opacity: 0.6 })); ring.rotation.x = Math.PI / 2; ring.position.y = 0.01; chestGroup.add(ring);
            
            chestGroup.position.copy(deathChest.position); scene.add(chestGroup); deathChest.mesh = chestGroup;
            document.getElementById('grave-hud').style.display = 'block'; document.getElementById('grave-timer').innerText = "60s";
            showNotification("¡Has muerto! Tu equipamiento quedó en tus coordenadas 📦", "#ff5555");
        }

        function removeDeathChest() {
            if (deathChest.mesh) { scene.remove(deathChest.mesh); deathChest.mesh = null; }
            deathChest.active = false; deathChest.resources = null; document.getElementById('grave-hud').style.display = 'none';
        }

        function spawnArrow(startPos, direction, owner) {
            const isFireball = owner === 'blaze';
            const arrowGeo = isFireball ? new THREE.SphereGeometry(0.15, 4, 4) : new THREE.BoxGeometry(0.06, 0.06, 0.4);
            const arrowMat = isFireball ? new THREE.MeshBasicMaterial({ color: 0xff5500 }) : new THREE.MeshBasicMaterial({ color: owner === 'player' ? 0xffffff : 0xaaaaaa });
            const arrowMesh = new THREE.Mesh(arrowGeo, arrowMat); arrowMesh.position.copy(startPos);
            if (!isFireball) arrowMesh.quaternion.setFromRotationMatrix(new THREE.Matrix4().lookAt(startPos, startPos.clone().add(direction), new THREE.Vector3(0, 1, 0)));
            scene.add(arrowMesh);
            activeArrows.push({ mesh: arrowMesh, dir: direction.clone().normalize(), speed: isFireball ? 0.45 : 0.8, life: 180, owner: owner });
        }

        function detonateCreeper(creeper) {
            scene.remove(creeper); playExplosionSound(); const pos = creeper.position; const radius = 3;
            if (!isCreative && player.position.distanceTo(pos) < 5) { health -= 35; showNotification("¡BOOM!", "red"); triggerDamageFlash(); }
            const cx = Math.round(pos.x), cy = Math.round(pos.y), cz = Math.round(pos.z);
            for (let x = -radius; x <= radius; x++) {
                for (let y = -radius; y <= radius; y++) {
                    for (let z = -radius; z <= radius; z++) {
                        if (x*x + y*y + z*z <= radius*radius) {
                            const key = `${cx+x},${cy+y},${cz+z}`; const v = worldData.get(key);
                            if (v && v.mesh && !["water", "lava", "obsidian", "end_portal_frame", "end_portal_frame_filled", "end_portal"].includes(v.type)) { scene.remove(v.mesh); worldData.delete(key); }
                        }
                    }
                }
            }
            const boomMat = new THREE.MeshBasicMaterial({ color: 0xff4400, transparent: true, opacity: 0.8 });
            const boomMesh = new THREE.Mesh(new THREE.SphereGeometry(radius, 8, 8), boomMat); boomMesh.position.copy(pos); scene.add(boomMesh);
            let scale = 1; const expand = () => { scale += 0.2; boomMesh.scale.set(scale, scale, scale); boomMat.opacity -= 0.05; if (boomMat.opacity > 0) requestAnimationFrame(expand); else scene.remove(boomMesh); }; expand();
        }

        function igniteTNT(x, y, z) {
            const posKey = `${x},${y},${z}`; const voxel = worldData.get(posKey);
            if (voxel) { if (voxel.mesh) scene.remove(voxel.mesh); worldData.delete(posKey); }
            const tntMesh = new THREE.Mesh(geometry, getMaterial("tnt")); tntMesh.position.set(x, y, z); scene.add(tntMesh);
            activeTnts.push({ mesh: tntMesh, x: x, y: y, z: z, tick: 0, velocity: new THREE.Vector3(0, 0.12, 0), originalMaterials: getMaterial("tnt") });
            playHissSound();
        }

        function detonateTNT(pos) {
            playExplosionSound(); const radius = 4; 
            if (!isCreative && player.position.distanceTo(pos) < 7) {
                const damage = Math.max(0, Math.round((7 - player.position.distanceTo(pos)) * 16)); health -= damage;
                showNotification(`¡EXPLOSIÓN! -${damage} HP 💥`, "red"); triggerDamageFlash();
            }
            for (let i = mobs.length - 1; i >= 0; i--) {
                let m = mobs[i];
                if (m.position.distanceTo(pos) < 7) {
                    m.userData.health -= Math.max(0, Math.round((7 - m.position.distanceTo(pos)) * 18));
                    if (m.userData.health <= 0) { scene.remove(m); mobs.splice(i, 1); showNotification("Enemigo vaporizado", "#ffff55"); }
                }
            }
            const cx = Math.round(pos.x); const cy = Math.round(pos.y); const cz = Math.round(pos.z);
            for (let x = -radius; x <= radius; x++) {
                for (let y = -radius; y <= radius; y++) {
                    for (let z = -radius; z <= radius; z++) {
                        if (x*x + y*y + z*z <= radius*radius) {
                            const key = `${cx+x},${cy+y},${cz+z}`; const v = worldData.get(key);
                            if (v && v.mesh && !["water", "lava", "obsidian", "end_portal_frame", "end_portal_frame_filled", "end_portal"].includes(v.type)) { scene.remove(v.mesh); worldData.delete(key); }
                        }
                    }
                }
            }
            const boomMat = new THREE.MeshBasicMaterial({ color: 0xffaa00, transparent: true, opacity: 0.9 });
            const boomMesh = new THREE.Mesh(new THREE.SphereGeometry(radius * 1.2, 12, 12), boomMat); boomMesh.position.copy(pos); scene.add(boomMesh);
            let scale = 1; const expand = () => { scale += 0.25; boomMesh.scale.set(scale, scale, scale); boomMat.opacity -= 0.06; if (boomMat.opacity > 0) requestAnimationFrame(expand); else scene.remove(boomMesh); }; expand();
        }

        function generateWorld() {
            if (currentDimension === "overworld") {
                for (let x = -VIEW_DISTANCE; x < VIEW_DISTANCE; x++) {
                    for (let z = -VIEW_DISTANCE; z < VIEW_DISTANCE; z++) {
                        const h = Math.floor(Math.sin(x * 0.06) * Math.cos(z * 0.06) * 4 + 10);
                        for (let y = 0; y < 16; y++) {
                            let type = "stone";
                            if (y < h) {
                                if (y === h - 1) {
                                    type = (h <= WATER_LEVEL + 1) ? "dirt" : "grass";
                                    if (h > WATER_LEVEL + 1 && Math.random() < 0.005) spawnTree(x, h, z);
                                } else if (y > h - 4) { type = "dirt"; }
                                else {
                                    const rand = Math.random();
                                    if (y < LAVA_LEVEL && rand < 0.06) type = "lava"; 
                                    else if (y === LAVA_LEVEL && rand < 0.08) type = "obsidian"; 
                                    else if (rand < 0.003) type = "diamond";
                                    else if (rand < 0.006) type = "emerald"; 
                                    else if (rand < 0.012) type = "gold";
                                    else if (rand < 0.024) type = "iron";
                                }
                            } else if (y <= WATER_LEVEL) { type = "water"; } else continue;
                            worldData.set(`${x},${y},${z}`, { type, mesh: null });
                        }
                    }
                }
            } else if (currentDimension === "nether") {
                for (let x = -VIEW_DISTANCE; x < VIEW_DISTANCE; x++) {
                    for (let z = -VIEW_DISTANCE; z < VIEW_DISTANCE; z++) {
                        const floorH = Math.floor(Math.sin(x * 0.08) * Math.cos(z * 0.08) * 3 + 5);
                        const ceilH = Math.floor(Math.cos(x * 0.05) * Math.sin(z * 0.05) * 2 + 13);
                        for (let y = 0; y < 16; y++) {
                            let type = null;
                            if (y <= floorH) {
                                type = "netherrack";
                                if (y === floorH && Math.random() < 0.15) type = "soulsand";
                                else if (y !== floorH && Math.random() < 0.04) type = "quartz";
                            } else if (y >= ceilH) {
                                type = "netherrack";
                                if (y === ceilH && Math.random() < 0.08) worldData.set(`${x},${y-1},${z}`, { type: "glowstone", mesh: null });
                            } else if (y <= 4) type = "lava"; 
                            if (type) worldData.set(`${x},${y},${z}`, { type, mesh: null });
                        }
                    }
                }
            } else if (currentDimension === "end") {
                for (let x = -30; x < 30; x++) {
                    for (let z = -30; z < 30; z++) {
                        const distSq = x*x + z*z;
                        if (distSq < 600) {
                            const h = 5 - Math.floor(distSq / 150);
                            for(let y = h - 3; y <= h; y++) worldData.set(`${x},${y},${z}`, { type: "end_stone", mesh: null });
                        }
                    }
                }
                const angles = [0, Math.PI/2, Math.PI, 3*Math.PI/2];
                angles.forEach(a => {
                    const px = Math.round(Math.cos(a)*15); const pz = Math.round(Math.sin(a)*15);
                    for(let y=5; y<=18; y++) worldData.set(`${px},${y},${pz}`, { type: 'obsidian', mesh: null});
                    worldData.set(`${px},19,${pz}`, { type: 'glowstone', mesh: null});
                });
            }
            renderWorld();
        }

        function renderWorld() {
            worldData.forEach((voxel, key) => {
                if (voxel.mesh) return;
                const [x, y, z] = key.split(',').map(Number);
                const mesh = new THREE.Mesh(geometry, getMaterial(voxel.type));
                mesh.position.set(x, y, z); mesh.userData = { x, y, z, type: voxel.type };
                scene.add(mesh); voxel.mesh = mesh;
            });
        }

        function switchDimension(targetDim = null) {
            if (currentDimension === "overworld") overworldData = new Map(worldData);
            else if (currentDimension === "nether") netherData = new Map(worldData);
            else if (currentDimension === "end") endData = new Map(worldData);

            if (!targetDim) targetDim = currentDimension === "overworld" ? "nether" : "overworld";
            currentDimension = targetDim;

            if (currentDimension === "nether") {
                document.getElementById("dimension-display").innerText = "Mundo: Nether 🔥"; document.getElementById("dimension-display").style.color = "#ff3333";
                scene.background = new THREE.Color(0x300808); scene.fog.color.set(0x200505); scene.sun.intensity = 0.1; scene.sun.color.set(0xff5522);
            } else if (currentDimension === "end") {
                document.getElementById("dimension-display").innerText = "Mundo: El End 👁️"; document.getElementById("dimension-display").style.color = "#aa00ff";
                scene.background = new THREE.Color(0x050510); scene.fog.color.set(0x020205); scene.sun.intensity = 0.05; scene.sun.color.set(0xaa88ff);
            } else {
                document.getElementById("dimension-display").innerText = "Mundo: Overworld 🌿"; document.getElementById("dimension-display").style.color = "#55ffaa";
                scene.background = new THREE.Color(0xa3d1ff); scene.fog.color.set(0xa3d1ff); scene.sun.intensity = 0.5; scene.sun.color.set(0xffffff);
            }

            worldData.forEach(v => { if (v.mesh) scene.remove(v.mesh); }); worldData.clear();
            mobs.forEach(m => scene.remove(m)); mobs.length = 0;

            let activeCache;
            if (currentDimension === "overworld") activeCache = overworldData;
            else if (currentDimension === "nether") activeCache = netherData;
            else activeCache = endData;
            
            if (activeCache.size > 0) { worldData = new Map(activeCache); renderWorld(); } 
            else generateWorld();

            // Plataforma segura
            const py = 7;
            for (let dx = -1; dx <= 1; dx++) {
                for (let dz = -1; dz <= 1; dz++) {
                    const blockKey = `${dx},${py-1},${dz}`; const target = worldData.get(blockKey);
                    if (target && target.mesh) scene.remove(target.mesh);
                    worldData.set(blockKey, { type: "obsidian", mesh: null });
                }
            }
            renderWorld();

            player.position.set(0, py + 1.5, 0); velocity.set(0, 0, 0);

            if (currentDimension === "nether") {
                for (let i = 0; i < 4; i++) spawnZombiePigman((Math.random()-0.5)*25, 8, (Math.random()-0.5)*25);
                for (let i = 0; i < 2; i++) spawnBlaze((Math.random()-0.5)*20, 9, (Math.random()-0.5)*20);
                showNotification("Has entrado al Nether...", "#ff3333");
            } else if (currentDimension === "end") {
                spawnEnderDragon(0, 30, 0); showNotification("¡El Ender Dragon despierta! 🐉", "#aa00ff");
            } else {
                for (let i = 0; i < 5; i++) {
                    const rx = (Math.random() - 0.5) * VIEW_DISTANCE; const rz = (Math.random() - 0.5) * VIEW_DISTANCE;
                    spawnPig(rx, 15, rz);
                }
                showNotification("De vuelta al Overworld", "#55ffaa");
            }

            setTimeout(() => { teleporting = false; document.getElementById('portal-flash').style.background = "rgba(128, 0, 128, 0)"; }, 800);
        }

        function updateCycle() {
            if (currentDimension === "nether") { document.getElementById('time-text').innerText = "Inframundo (Eterno) 🔥"; return; }
            if (currentDimension === "end") { document.getElementById('time-text').innerText = "El End (Vacío) 👁️"; return; }

            gameTime += 0.016; const cycleDuration = 120; const current = gameTime % cycleDuration;
            
            if (current > 60 && !isNight) {
                isNight = true; scene.background = new THREE.Color(0x0a0a1a); scene.fog.color.set(0x050510); scene.sun.intensity = 0.05;
                for(let i=0; i<3; i++) spawnSkeleton(player.position.x + (Math.random()-0.5)*30, 20, player.position.z + (Math.random()-0.5)*30);
                for(let i=0; i<2; i++) spawnCreeper(player.position.x + (Math.random()-0.5)*30, 20, player.position.z + (Math.random()-0.5)*30);
                for(let i=0; i<3; i++) spawnZombie(player.position.x + (Math.random()-0.5)*30, 20, player.position.z + (Math.random()-0.5)*30);
            } else if (current <= 60 && isNight) {
                isNight = false; scene.background = new THREE.Color(0xa3d1ff); scene.fog.color.set(0xa3d1ff); scene.sun.intensity = 0.5;
                for (let i = mobs.length - 1; i >= 0; i--) {
                    if (['skeleton', 'creeper', 'zombie'].includes(mobs[i].userData.type)) { scene.remove(mobs[i]); mobs.splice(i, 1); }
                }
                for(let i=0; i<3; i++) {
                    const rx = player.position.x + (Math.random()-0.5)*40; const rz = player.position.z + (Math.random()-0.5)*40; const rand = Math.random();
                    if (rand < 0.25) spawnPig(rx, 20, rz); else if (rand < 0.5) spawnCow(rx, 20, rz); else if (rand < 0.75) spawnChicken(rx, 20, rz); else spawnSheep(rx, 20, rz);
                }
            }

            respawnTimer += 0.016;
            if (respawnTimer >= 4.0) { 
                respawnTimer = 0;
                const hostileCount = mobs.filter(m => ['skeleton', 'creeper', 'zombie'].includes(m.userData.type)).length;
                const peacefulCount = mobs.filter(m => peacefulTypes.includes(m.userData.type)).length;
                
                if (isNight && hostileCount < 8) {
                    const rx = player.position.x + (Math.random() - 0.5) * 45; const rz = player.position.z + (Math.random() - 0.5) * 45; const rand = Math.random();
                    if (rand < 0.33) spawnSkeleton(rx, 22, rz); else if (rand < 0.66) spawnCreeper(rx, 22, rz); else spawnZombie(rx, 22, rz);
                } else if (!isNight && peacefulCount < 8) {
                    const rx = player.position.x + (Math.random() - 0.5) * 45; const rz = player.position.z + (Math.random() - 0.5) * 45; const rand = Math.random();
                    if (rand < 0.25) spawnPig(rx, 22, rz); else if (rand < 0.5) spawnCow(rx, 22, rz); else if (rand < 0.75) spawnChicken(rx, 22, rz); else spawnSheep(rx, 22, rz);
                }
            }

            const sec = Math.floor(current % 60);
            document.getElementById('time-text').innerText = `${isNight ? "Noche" : "Día"} - 00:${sec.toString().padStart(2, '0')}`;
        }

        function isBlockAt(x, y, z) {
            const voxel = worldData.get(`${Math.round(x)},${Math.round(y)},${Math.round(z)}`);
            return (voxel && voxel.type !== "water" && voxel.type !== "lava" && voxel.type !== "portal");
        }

        // Mejora de colisiones: Evita atravesar paredes bloqueando el paso si el cuerpo o cabeza chocan
        function canMoveTo(x, y, z) {
            return !isBlockAt(x, y + 0.1, z) && !isBlockAt(x, y + 1.1, z);
        }

        function triggerDamageFlash() {
            const flash = document.getElementById('damage-flash'); flash.style.background = "rgba(255, 0, 0, 0.4)";
            setTimeout(() => { flash.style.background = "transparent"; }, 150);
        }

        function updatePlayer() {
            if(player.position.y < -20) { if (!isCreative) handleDeath(); else { player.position.set(0, 30, 0); velocity.set(0,0,0); } }

            const px = Math.round(player.position.x); const py = Math.round(player.position.y); const pz = Math.round(player.position.z);
            const blockAtFeet = worldData.get(`${px},${py},${pz}`)?.type;

            const inWater = blockAtFeet === "water"; const inLava = blockAtFeet === "lava"; const inSoulSand = blockAtFeet === "soulsand";
            if (inLava && !isCreative) { health -= 1.0; triggerDamageFlash(); }

            const baseSpeed = isCreative ? 0.4 : 0.22; // Velocidad ajustada para evitar atravesar bloques
            const moveSpeed = inWater ? 0.12 : (inLava ? 0.06 : (inSoulSand ? baseSpeed * 0.4 : baseSpeed));
            const gravity = inWater ? 0.005 : (inLava ? 0.003 : 0.012);

            const dir = new THREE.Vector3(0, 0, -1).applyQuaternion(player.quaternion); const side = new THREE.Vector3(1, 0, 0).applyQuaternion(player.quaternion);
            let moveVec = new THREE.Vector3();
            if (keys['KeyW']) moveVec.add(dir); if (keys['KeyS']) moveVec.add(dir.clone().negate());
            if (keys['KeyA']) moveVec.add(side.clone().negate()); if (keys['KeyD']) moveVec.add(side);
            
            if(moveVec.length() > 0) {
                moveVec.normalize().multiplyScalar(moveSpeed);
                if (canMoveTo(player.position.x + moveVec.x, player.position.y, player.position.z)) player.position.x += moveVec.x;
                if (canMoveTo(player.position.x, player.position.y, player.position.z + moveVec.z)) player.position.z += moveVec.z;
            }

            if (isCreative && isFlying) {
                velocity.y = 0;
                if (keys['Space'] || keys['ArrowUp']) player.position.y += 0.4; 
                if (keys['ShiftLeft'] || keys['ArrowDown']) player.position.y -= 0.4; 
            } else {
                velocity.y -= gravity; player.position.y += velocity.y;
                const groundY = Math.round(player.position.y - 0.5); const blockUnder = worldData.get(`${px},${groundY},${pz}`)?.type;
                if (blockUnder && !["water", "lava", "portal"].includes(blockUnder) && player.position.y <= groundY + 0.5) {
                    player.position.y = groundY + 0.5; velocity.y = 0;
                    if (keys['Space']) velocity.y = 0.25; 
                }
                if ((inWater || inLava) && keys['Space']) velocity.y = 0.08;
            }

            if (isThirdPerson) {
                camera.position.lerp(player.position.clone().add(new THREE.Vector3(0, 3, 5).applyQuaternion(player.quaternion)), 0.15); camera.lookAt(player.position.clone().add(new THREE.Vector3(0, 1, 0))); player.bodyParts.forEach(p => p.visible = true);
            } else {
                camera.position.copy(player.position).add(new THREE.Vector3(0, 1.6, 0)); camera.rotation.set(pitch, yaw + Math.PI, 0, 'YXZ'); player.bodyParts.forEach(p => p.visible = false);
            }

            document.getElementById('health-bar').style.width = Math.max(0, health) + "%";
            if(health <= 0) handleDeath();
            checkPortalCollision();
        }

        function checkPortalCollision() {
            if (teleporting) return;
            const px = Math.round(player.position.x); const py = Math.round(player.position.y); const pz = Math.round(player.position.z);
            const feetBlock = worldData.get(`${px},${py},${pz}`)?.type; const headBlock = worldData.get(`${px},${py+1},${pz}`)?.type;

            if (feetBlock === "portal" || headBlock === "portal") {
                portalTimer += 0.016; document.getElementById("portal-flash").style.background = `rgba(128, 0, 128, ${Math.min(0.85, portalTimer / 1.5)})`;
                if (portalTimer === 0.016) playPortalSound();
                if (portalTimer >= 1.5) { teleporting = true; portalTimer = 0; switchDimension(currentDimension === "nether" ? "overworld" : "nether"); }
            } else if (feetBlock === "end_portal" || headBlock === "end_portal") {
                portalTimer += 0.016; document.getElementById("portal-flash").style.background = `rgba(0, 0, 0, ${Math.min(0.95, portalTimer / 1.5)})`;
                if (portalTimer === 0.016) playPortalSound();
                if (portalTimer >= 1.5) { teleporting = true; portalTimer = 0; switchDimension(currentDimension === "end" ? "overworld" : "end"); }
            } else {
                if (portalTimer > 0) {
                    portalTimer = Math.max(0, portalTimer - 0.05);
                    document.getElementById("portal-flash").style.background = `rgba(128, 0, 128, ${Math.min(0.85, portalTimer / 1.5)})`;
                }
            }
        }

        function handleDeath() {
            health = 100; const deathPosition = player.position.clone();
            if (!isCreative) {
                let hasItems = false; const droppedResources = {};
                for (let key in resources) {
                    if (resources[key] > 0 && resources[key] !== Infinity) { droppedResources[key] = resources[key]; resources[key] = 0; hasItems = true; }
                }
                if (hasItems) spawnDeathChest(deathPosition, droppedResources); else showNotification("¡HAS MUERTO! (Inventario vacío)", "red");
            } else showNotification("¡HAS MUERTO! (Modo Creativo - No pierdes objetos)", "red");
            player.position.set(0, 30, 0); velocity.set(0, 0, 0); updateInventoryUI(); if (isLargeInventoryOpen) renderLargeInventory();
        }

        function moveMobSafely(m, dx, dz) {
            let mobY = m.position.y; let nextX = m.position.x + dx;
            let collisionX = isBlockAt(nextX, mobY + 0.1, m.position.z) || isBlockAt(nextX, mobY + 1.1, m.position.z);
            if (!collisionX) m.position.x = nextX;
            else if (!isBlockAt(nextX, mobY + 1.1, m.position.z) && !isBlockAt(nextX, mobY + 2.1, m.position.z) && m.userData.velocity.y <= 0) m.userData.velocity.y = 0.22; 

            let nextZ = m.position.z + dz;
            let collisionZ = isBlockAt(m.position.x, mobY + 0.1, nextZ) || isBlockAt(m.position.x, mobY + 1.1, nextZ);
            if (!collisionZ) m.position.z = nextZ;
            else if (!isBlockAt(m.position.x, mobY + 1.1, nextZ) && !isBlockAt(m.position.x, mobY + 2.1, nextZ) && m.userData.velocity.y <= 0) m.userData.velocity.y = 0.22; 
        }

        function updateEntities() {
            if (deathChest.active && deathChest.mesh) {
                deathChest.mesh.rotation.y += 0.02; deathChest.mesh.position.y = deathChest.position.y + Math.sin(Date.now() * 0.003) * 0.12; deathChest.timer -= 0.016;
                document.getElementById('grave-timer').innerText = `${Math.max(0, Math.ceil(deathChest.timer))}s`;
                if (player.position.distanceTo(deathChest.mesh.position) < 2.0) {
                    for (let key in deathChest.resources) resources[key] += deathChest.resources[key];
                    showNotification("¡Recuperaste tu equipamiento! 🎒✨", "#ffd700"); playBlockSound(false); removeDeathChest(); updateInventoryUI(); if (isLargeInventoryOpen) renderLargeInventory();
                } else if (deathChest.timer <= 0) { removeDeathChest(); showNotification("La tumba se ha desintegrado. 😢", "#ff5555"); }
            }

            if (pigmenAngered) {
                pigmenAngerTimer -= 0.016;
                if (pigmenAngerTimer <= 0) { pigmenAngered = false; showNotification("La ira de los Pigmans se ha calmado 🐷", "#55ffaa"); }
            }

            for (let i = activeTnts.length - 1; i >= 0; i--) {
                let tnt = activeTnts[i]; tnt.tick++; tnt.velocity.y -= 0.012; tnt.mesh.position.add(tnt.velocity);
                const ty = Math.round(tnt.mesh.position.y - 0.5); const blockUnder = worldData.get(`${Math.round(tnt.mesh.position.x)},${ty},${Math.round(tnt.mesh.position.z)}`)?.type;
                if (blockUnder && !["water", "lava", "portal"].includes(blockUnder) && tnt.mesh.position.y <= ty + 1.0) { tnt.mesh.position.y = ty + 1.0; tnt.velocity.set(0, 0, 0); }
                tnt.mesh.material = (Math.floor(tnt.tick / 8) % 2 === 0) ? tntFlashMat : tnt.originalMaterials;
                const pulseScale = 1.0 + Math.sin(tnt.tick * 0.25) * 0.08; tnt.mesh.scale.set(pulseScale, pulseScale, pulseScale);
                if (tnt.tick >= 120) { detonateTNT(tnt.mesh.position); scene.remove(tnt.mesh); activeTnts.splice(i, 1); }
            }

            for (let i = mobs.length - 1; i >= 0; i--) {
                let m = mobs[i]; const dist = m.position.distanceTo(player.position);
                
                if (m.userData.type === 'creeper') {
                    if (m.userData.isFusing) {
                        m.userData.fuse += 0.016; m.userData.mat.emissive.setHex((Math.floor(m.userData.fuse * 10) % 2 === 0) ? 0xffffff : 0x000000);
                        if (m.userData.fuse >= 1.5) { detonateCreeper(m); mobs.splice(i, 1); continue; }
                    } else if (dist < 15) {
                        if (dist < 2.5 && !isCreative) m.userData.isFusing = true;
                        else { const chaseDir = player.position.clone().sub(m.position).normalize(); moveMobSafely(m, chaseDir.x * 0.04, chaseDir.z * 0.04); m.lookAt(player.position.x, m.position.y, player.position.z); }
                    }
                } else if (m.userData.type === 'skeleton') {
                    if (dist < 15) {
                        m.lookAt(player.position.x, m.position.y, player.position.z); const dir = player.position.clone().sub(m.position); dir.y = 0; const currentDist = dir.length(); dir.normalize();
                        let dx = 0, dz = 0;
                        if (currentDist > 8) { dx = dir.x * 0.04; dz = dir.z * 0.04; } else if (currentDist < 5) { dx = -dir.x * 0.03; dz = -dir.z * 0.03; }
                        if (dx !== 0 || dz !== 0) moveMobSafely(m, dx, dz);
                        m.userData.shootCooldown -= 0.016;
                        if (m.userData.shootCooldown <= 0 && !isCreative) {
                            spawnArrow(m.position.clone().add(new THREE.Vector3(0, 1.2, 0)), player.position.clone().add(new THREE.Vector3(0, 1.0, 0)).sub(m.position).normalize(), 'skeleton'); m.userData.shootCooldown = 2.0 + Math.random() * 1.5; 
                        }
                    }
                } else if (m.userData.type === 'zombie') {
                    if (dist < 20) {
                        m.lookAt(player.position.x, m.position.y, player.position.z); const dir = player.position.clone().sub(m.position).normalize(); moveMobSafely(m, dir.x * 0.042, dir.z * 0.042);
                        if (m.userData.attackCooldown > 0) m.userData.attackCooldown -= 0.016;
                        if (dist < 1.3 && !isCreative && m.userData.attackCooldown <= 0) { health -= 15; triggerDamageFlash(); showNotification("¡Te ha mordido un Zombie! 🧟", "red"); m.userData.attackCooldown = 1.2; }
                    }
                } else if (m.userData.type === 'zombie_pigman') {
                    if (pigmenAngered && dist < 20) {
                        m.lookAt(player.position.x, m.position.y, player.position.z); const dir = player.position.clone().sub(m.position).normalize(); moveMobSafely(m, dir.x * 0.065, dir.z * 0.065);
                        if (m.userData.attackCooldown > 0) m.userData.attackCooldown -= 0.016;
                        if (dist < 1.4 && !isCreative && m.userData.attackCooldown <= 0) { health -= 18; triggerDamageFlash(); showNotification("¡Ataque de Zombie Pigman! 🐷⚔️", "red"); m.userData.attackCooldown = 1.0; }
                    } else if (dist < 20) {
                        if (Math.random() < 0.01) m.userData.wanderDir = new THREE.Vector3(Math.random()-0.5, 0, Math.random()-0.5).normalize();
                        if (m.userData.wanderDir) moveMobSafely(m, m.userData.wanderDir.x * 0.02, m.userData.wanderDir.z * 0.02);
                    }
                } else if (m.userData.type === 'blaze') {
                    m.userData.angle += 0.05;
                    if (m.rods) m.rods.forEach((rod, idx) => { const offsetAngle = m.userData.angle + (idx * Math.PI / 2); rod.position.set(Math.cos(offsetAngle) * 0.35, Math.sin(offsetAngle * 0.5) * 0.25, Math.sin(offsetAngle) * 0.35); });
                    if (dist < 18) {
                        m.lookAt(player.position.x, m.position.y, player.position.z); m.userData.shootCooldown -= 0.016;
                        if (m.userData.shootCooldown <= 0 && !isCreative) {
                            spawnArrow(m.position.clone().add(new THREE.Vector3(0, 1.0, 0)), player.position.clone().add(new THREE.Vector3(0, 0.5, 0)).sub(m.position).normalize(), 'blaze'); m.userData.shootCooldown = 2.5 + Math.random() * 1.5;
                        }
                    }
                } else if (m.userData.type === 'ender_dragon') {
                    m.userData.angle += 0.02;
                    m.userData.wingL.rotation.z = Math.sin(m.userData.angle * 5) * 0.5; m.userData.wingR.rotation.z = -Math.sin(m.userData.angle * 5) * 0.5;
                    const targetX = player.position.x + Math.cos(m.userData.angle) * 15; const targetZ = player.position.z + Math.sin(m.userData.angle) * 15; const targetY = player.position.y + 12 + Math.sin(m.userData.angle * 2) * 5;
                    m.position.lerp(new THREE.Vector3(targetX, targetY, targetZ), 0.02); m.lookAt(player.position);
                    m.userData.shootCooldown -= 0.016;
                    if (m.userData.shootCooldown <= 0 && !isCreative) {
                        spawnArrow(m.position.clone().add(new THREE.Vector3(0, -1, 3).applyQuaternion(m.quaternion)), player.position.clone().sub(m.position).normalize(), 'blaze'); m.userData.shootCooldown = 2.0 + Math.random() * 2.0;
                    }
                } else if (peacefulTypes.includes(m.userData.type)) {
                    m.userData.wanderTimer -= 0.016;
                    if (m.userData.panicTimer > 0) {
                        m.userData.panicTimer -= 0.016; const escapeDir = m.position.clone().sub(player.position); escapeDir.y = 0; escapeDir.normalize();
                        const panicSpeed = m.userData.type === 'chicken' ? 0.08 : 0.1; moveMobSafely(m, escapeDir.x * panicSpeed, escapeDir.z * panicSpeed); m.lookAt(m.position.clone().add(escapeDir));
                    } else if (m.userData.wanderTimer <= 0) {
                        m.userData.wanderDir.set(Math.random() - 0.5, 0, Math.random() - 0.5).normalize(); m.userData.wanderTimer = 2.0 + Math.random() * 3.0; 
                    } else {
                        const wanderSpeed = m.userData.type === 'chicken' ? 0.015 : 0.02; moveMobSafely(m, m.userData.wanderDir.x * wanderSpeed, m.userData.wanderDir.z * wanderSpeed);
                        if (m.userData.wanderDir.lengthSq() > 0.01) m.lookAt(m.position.clone().add(m.userData.wanderDir));
                    }
                }

                m.userData.velocity.y -= 0.01; m.position.y += m.userData.velocity.y; let ePy = Math.round(m.position.y - 0.5);
                const blockUnderMob = worldData.get(`${Math.round(m.position.x)},${ePy},${Math.round(m.position.z)}`)?.type;
                if(blockUnderMob && !["water", "lava", "portal"].includes(blockUnderMob) && m.position.y <= ePy + 0.5) { m.position.y = ePy + 0.5; m.userData.velocity.y = 0; }
            }

            for (let i = activeArrows.length - 1; i >= 0; i--) {
                let arrow = activeArrows[i]; arrow.mesh.position.add(arrow.dir.clone().multiplyScalar(arrow.speed)); arrow.life--;
                let hitRegistered = false;

                if (arrow.owner === 'skeleton' && !isCreative) {
                    if (arrow.mesh.position.distanceTo(player.position.clone().add(new THREE.Vector3(0, 1.0, 0))) < 1.0) { health -= 12; triggerDamageFlash(); showNotification("¡Recibiste un flechazo! 🏹", "red"); hitRegistered = true; }
                } else if (arrow.owner === 'blaze' && !isCreative) {
                    if (arrow.mesh.position.distanceTo(player.position.clone().add(new THREE.Vector3(0, 1.0, 0))) < 1.2) { health -= 15; triggerDamageFlash(); showNotification("¡Golpe directo de bola de fuego! ☄️💥", "#ff5500"); hitRegistered = true; playExplosionSound(); }
                } else if (arrow.owner === 'player') {
                    for (let j = mobs.length - 1; j >= 0; j--) {
                        let m = mobs[j];
                        if (arrow.mesh.position.distanceTo(m.position.clone().add(new THREE.Vector3(0, 0.8, 0))) < 1.0) {
                            m.userData.health -= 2; hitRegistered = true;
                            if (m.userData.health <= 0) {
                                scene.remove(m); mobs.splice(j, 1);
                                if (m.userData.type === 'skeleton') { hasBow = true; resources.arrows += 10; showNotification("¡Esqueleto derrotado! +1 Arco 🏹", "#ffff55"); } 
                                else if (m.userData.type === 'zombie_pigman') { resources.gold += 3; showNotification("¡Pigman derrotado! +3 Oro 📀", "#ffd700"); } 
                                else if (m.userData.type === 'blaze') { resources.glowstone += 3; showNotification("¡Blaze derrotado! +3 Glowstone 🟡", "#ffffaa"); } 
                                else if (m.userData.type === 'ender_dragon') {
                                    showNotification("¡HAS DERROTADO AL ENDER DRAGON! 🏆✨", "#aa00ff"); playExplosionSound();
                                    const ex = Math.round(m.position.x); const ey = Math.round(m.position.y - 10); const ez = Math.round(m.position.z);
                                    for(let px=-2; px<=2; px++) { for(let pz=-2; pz<=2; pz++) worldData.set(`${ex+px},${ey},${ez+pz}`, { type: 'obsidian', mesh: null}); }
                                    worldData.set(`${ex},${ey+1},${ez}`, { type: 'end_portal', mesh: null}); renderWorld();
                                } 
                                else if (m.userData.type === 'zombie') { resources.meat += 2; showNotification("+2 Carne 🥩", "#55ff55"); } 
                                else if (m.userData.type === 'pig') { resources.meat += 2; showNotification("+2 Filetes Crudos 🥩", "#ffaacc"); } 
                                else if (m.userData.type === 'cow') { resources.beef += 2; showNotification("+2 Filetes de Vaca 🥩", "#b57c50"); }
                                updateInventoryUI(); if(isLargeInventoryOpen) renderLargeInventory();
                            } else if (m.userData.type === 'zombie_pigman') { pigmenAngered = true; pigmenAngerTimer = 30.0; showNotification("¡Has enfadado a los Zombie Pigman! 🐷⚔️", "red"); }
                            break;
                        }
                    }
                }

                if (isBlockAt(Math.round(arrow.mesh.position.x), Math.round(arrow.mesh.position.y), Math.round(arrow.mesh.position.z))) { hitRegistered = true; if (arrow.owner === 'blaze') playExplosionSound(); }
                if (hitRegistered || arrow.life <= 0) { scene.remove(arrow.mesh); activeArrows.splice(i, 1); }
            }
        }

        function handleSlotChange(nextSlot) {
            if (nextSlot < 1 || nextSlot > 9) return;
            const type = slotToType[nextSlot];
            if (!isCreative && type === "bow" && !hasBow) { showNotification("¡Derrota a un esqueleto para obtener un arco! 🏹", "orange"); return; }
            if (!isCreative && type === "flint_and_steel" && !hasFlintAndSteel) { showNotification("¡Fabrica un Esquero en el menú de Crafteo! 🔥", "orange"); return; }
            selectedSlot = nextSlot; updateInventoryUI();
            if (player && player.toolVisuals) {
                player.toolVisuals.pick.visible = (type === "pickaxe" && (isCreative || pickaxeLevel > 0));
                player.toolVisuals.sword.visible = (type === "sword" && (isCreative || swordLevel > 0));
                player.toolVisuals.bow.visible = (type === "bow" && (isCreative || hasBow));
                player.toolVisuals.flint_and_steel.visible = (type === "flint_and_steel" && (isCreative || hasFlintAndSteel));
                const toolColor = [0x8B4513, 0x8B4513, 0xdadada, 0xFFD700, 0x33eaff][type === "pickaxe" ? pickaxeLevel : swordLevel] || 0xffffff;
                if (type === "pickaxe") player.toolVisuals.pick.material.color.setHex(toolColor);
                if (type === "sword") player.toolVisuals.sword.material.color.setHex(toolColor);
            }
        }

        function selectSlotByClick(slotNumber) {
            if (isLargeInventoryOpen || isCraftingOpen) {
                const type = slotToType[slotNumber];
                if (!isCreative && type === "bow" && !hasBow) return;
                if (!isCreative && type === "flint_and_steel" && !hasFlintAndSteel) return;
                selectedSlot = slotNumber; updateInventoryUI(); showNotification(`Ranura ${slotNumber} seleccionada como destino`, "#ffd700");
            } else handleSlotChange(slotNumber);
        }

        function tryActivateEndPortal(cx, cy, cz) {
            for (let ox = -3; ox <= 3; ox++) {
                for (let oz = -3; oz <= 3; oz++) {
                    let center = {x: cx+ox, y: cy, z: cz+oz}; let valid = true;
                    let required = [ [center.x-1, center.z-2], [center.x, center.z-2], [center.x+1, center.z-2], [center.x-1, center.z+2], [center.x, center.z+2], [center.x+1, center.z+2], [center.x-2, center.z-1], [center.x-2, center.z], [center.x-2, center.z+1], [center.x+2, center.z-1], [center.x+2, center.z], [center.x+2, center.z+1] ];
                    for(let i=0; i<required.length; i++) { if (worldData.get(`${required[i][0]},${center.y},${required[i][1]}`)?.type !== 'end_portal_frame_filled') { valid = false; break; } }
                    if (valid) {
                        for(let x=-1; x<=1; x++) for(let z=-1; z<=1; z++) worldData.set(`${center.x+x},${center.y},${center.z+z}`, { type: 'end_portal', mesh: null });
                        renderWorld(); playPortalSound(); showNotification("¡Portal del End Abierto! 👁️✨", "#aa00ff"); return true;
                    }
                }
            }
            return false;
        }

        function tryBuildPortalFrame(x, y, z) {
            let zFound = false;
            for (let offset = -1; offset <= 0; offset++) {
                const baseZ = z + offset;
                const matches = 
                    !isBlockAt(x, y+1, baseZ+1) && !isBlockAt(x, y+1, baseZ+2) && !isBlockAt(x, y+2, baseZ+1) && !isBlockAt(x, y+2, baseZ+2) && !isBlockAt(x, y+3, baseZ+1) && !isBlockAt(x, y+3, baseZ+2) &&
                    worldData.get(`${x},${y},${baseZ+1}`)?.type === "obsidian" && worldData.get(`${x},${y},${baseZ+2}`)?.type === "obsidian" && worldData.get(`${x},${y+1},${baseZ}`)?.type === "obsidian" && worldData.get(`${x},${y+2},${baseZ}`)?.type === "obsidian" && worldData.get(`${x},${y+3},${baseZ}`)?.type === "obsidian" && worldData.get(`${x},${y+1},${baseZ+3}`)?.type === "obsidian" && worldData.get(`${x},${y+2},${baseZ+3}`)?.type === "obsidian" && worldData.get(`${x},${y+3},${baseZ+3}`)?.type === "obsidian" && worldData.get(`${x},${y+4},${baseZ+1}`)?.type === "obsidian" && worldData.get(`${x},${y+4},${baseZ+2}`)?.type === "obsidian";
                if (matches) { for (let h = 1; h <= 3; h++) { worldData.set(`${x},${y+h},${baseZ+1}`, { type: "portal", mesh: null }); worldData.set(`${x},${y+h},${baseZ+2}`, { type: "portal", mesh: null }); } zFound = true; }
            }
            let xFound = false;
            for (let offset = -1; offset <= 0; offset++) {
                const baseX = x + offset;
                const matches = 
                    !isBlockAt(baseX+1, y+1, z) && !isBlockAt(baseX+2, y+1, z) && !isBlockAt(baseX+1, y+2, z) && !isBlockAt(baseX+2, y+2, z) && !isBlockAt(baseX+1, y+3, z) && !isBlockAt(baseX+2, y+3, z) &&
                    worldData.get(`${baseX+1},${y},${z}`)?.type === "obsidian" && worldData.get(`${baseX+2},${y},${z}`)?.type === "obsidian" && worldData.get(`${baseX},${y+1},${z}`)?.type === "obsidian" && worldData.get(`${baseX},${y+2},${z}`)?.type === "obsidian" && worldData.get(`${baseX},${y+3},${z}`)?.type === "obsidian" && worldData.get(`${baseX+3},${y+1},${z}`)?.type === "obsidian" && worldData.get(`${baseX+3},${y+2},${z}`)?.type === "obsidian" && worldData.get(`${baseX+3},${y+3},${z}`)?.type === "obsidian" && worldData.get(`${baseX+1},${y+4},${z}`)?.type === "obsidian" && worldData.get(`${baseX+2},${y+4},${z}`)?.type === "obsidian";
                if (matches) { for (let h = 1; h <= 3; h++) { worldData.set(`${baseX+1},${y+h},${z}`, { type: "portal", mesh: null }); worldData.set(`${baseX+2},${y+h},${z}`, { type: "portal", mesh: null }); } xFound = true; }
            }
            if (zFound || xFound) { renderWorld(); showNotification("¡Portal Interdimensional Activado! 🔮", "#da44ff"); playPortalSound(); return true; }
            return false;
        }

        function handleAction(e) {
            if (!document.pointerLockElement) return;
            player.arm.rotation.x = -1; setTimeout(() => player.arm.rotation.x = 0, 100);
            const ray = new THREE.Raycaster(); ray.setFromCamera(new THREE.Vector2(0,0), camera);
            const type = slotToType[selectedSlot];

            if(e.button === 0) { 
                if (type === "bow") {
                    if (resources.arrows > 0 || isCreative) { if (!isCreative) resources.arrows--; spawnArrow(camera.position.clone().add(new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize().multiplyScalar(0.5)), new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize(), 'player'); playBowSound(); updateInventoryUI(); } 
                    else showNotification("Sin flechas 🏹", "red");
                    return;
                }

                const hits = ray.intersectObjects(mobs, true);
                if(hits.length > 0 && hits[0].distance < 4) {
                    let entity = hits[0].object; while(entity.parent && !entity.userData.velocity) entity = entity.parent;
                    if (entity.userData.health) entity.userData.health -= (type === "sword") ? (swordLevel + 1) * 3 : 1;
                    if(!entity.userData.health || entity.userData.health <= 0) {
                        scene.remove(entity); const idx = mobs.indexOf(entity); if(idx > -1) mobs.splice(idx, 1);
                        if (entity.userData.type === 'skeleton') { hasBow = true; resources.arrows += 10; showNotification("¡Esqueleto derrotado! +1 Arco 🏹", "#ffff55"); } 
                        else if (entity.userData.type === 'zombie_pigman') { resources.gold += 3; showNotification("¡Pigman derrotado! +3 Oro 📀", "#ffd700"); } 
                        else if (entity.userData.type === 'blaze') { resources.glowstone += 3; showNotification("¡Blaze derrotado! +3 Glowstone 🟡", "#ffffaa"); } 
                        else if (entity.userData.type === 'zombie') { resources.meat += 2; showNotification("+2 Carne 🥩", "#55ff55"); } 
                        else if (entity.userData.type === 'pig') { resources.meat += 2; showNotification("+2 Filetes Crudos 🥩", "#ffaacc"); } 
                        else if (entity.userData.type === 'cow') { resources.beef += 2; showNotification("+2 Filetes de Vaca 🥩", "#b57c50"); } 
                        else showNotification("¡Enemigo derrotado!", "#55ff55");
                        updateInventoryUI(); if(isLargeInventoryOpen) renderLargeInventory();
                    } else {
                        if (entity.userData.type === 'zombie_pigman') { pigmenAngered = true; pigmenAngerTimer = 30.0; showNotification("¡Has enfadado a los Zombie Pigman! 🐷⚔️", "red"); } 
                        else if (peacefulTypes.includes(entity.userData.type)) { entity.userData.panicTimer = 3.0; }
                    }
                    return;
                }

                const blockHits = ray.intersectObjects(scene.children.filter(c => c.userData.type));
                if (blockHits.length > 0 && blockHits[0].distance < 6) {
                    const obj = blockHits[0].object; const blockType = obj.userData.type;
                    if (["water", "lava", "portal", "end_portal"].includes(blockType)) return;
                    if (blockType === "obsidian" && !isCreative && pickaxeLevel < 4) { showNotification("¡Requiere Pico de Diamante! 💎⛏️", "orange"); return; }
                    if (!isCreative && ["stone", "iron", "gold", "diamond", "emerald", "obsidian", "quartz"].includes(blockType) && type !== "pickaxe") { showNotification("¡Necesitas usar el Pico!", "orange"); return; }
                    
                    scene.remove(obj); worldData.delete(`${obj.userData.x},${obj.userData.y},${obj.userData.z}`); playBlockSound(true); history.push({ action: 'break', x: obj.userData.x, y: obj.userData.y, z: obj.userData.z, type: blockType });
                    if (!isCreative) {
                        if (blockType === "wood") resources.wood++; else if (blockType === "stone") { resources.stone++; if (Math.random() < 0.15) resources.coal += 1 + Math.floor(Math.random() * 2); }
                        else if (blockType === "iron") resources.iron++; else if (blockType === "gold") resources.gold++; else if (blockType === "diamond") resources.diamond++; else if (blockType === "emerald") resources.emerald++; else if (blockType === "coal") resources.coal++;
                        else if (blockType === "obsidian") resources.obsidian++; else if (blockType === "tnt") resources.tnt++; else if (blockType === "netherrack") resources.netherrack++; else if (blockType === "soulsand") resources.soulsand++; else if (blockType === "glowstone") resources.glowstone++; else if (blockType === "quartz") resources.quartz++;
                        else if (blockType === "end_stone") resources.end_stone++; else if (blockType === "end_portal_frame") resources.end_portal_frame++; else if (blockType === "end_portal_frame_filled") resources.end_portal_frame++;
                        else if (blockType === "leaves" && Math.random() < 0.25) resources.apple++;
                        updateInventoryUI();
                    }
                }
            } else if (e.button === 2) { 
                if (foodValues[type]) {
                    const food = foodValues[type];
                    if (!isCreative) {
                        if (resources[itemMetaData[type].resourceName] > 0) {
                            if (health >= 100) { showNotification("¡Tu vida ya está al máximo! ❤️", "#55ff55"); return; }
                            resources[itemMetaData[type].resourceName]--; health = Math.min(100, health + food.heal); showNotification(`¡Comiste ${food.name}! (+${food.heal} Vida)`, "#55ff55"); playBlockSound(false); updateInventoryUI(); if(isLargeInventoryOpen) renderLargeInventory();
                        } else showNotification(`No tienes ${food.name} ❌.`, "red");
                    } else {
                        if (health >= 100) { showNotification("¡Vida al máximo! (Creativo) ❤️", "#ffcc00"); return; }
                        health = 100; showNotification(`¡${food.name} consumido! (Modo Creativo)`, "#55ff55");
                    }
                    return;
                }

                if (type === "flint_and_steel") {
                    const blockHits = ray.intersectObjects(scene.children.filter(c => c.userData.type));
                    if (blockHits.length > 0 && blockHits[0].distance < 6) {
                        const hitObj = blockHits[0].object; const hx = hitObj.userData.x, hy = hitObj.userData.y, hz = hitObj.userData.z;
                        if (hitObj.userData.type === "tnt") { igniteTNT(hx, hy, hz); showNotification("¡TNT encendida! 🧨 ¡Huye!", "#ff3333"); } 
                        else if (hitObj.userData.type === "obsidian") {
                            if (!tryBuildPortalFrame(hx, hy, hz)) {
                                playSparkSound();
                                if (!isBlockAt(hx, hy+1, hz)) { worldData.set(`${hx},${hy+1},${hz}`, { type: "portal", mesh: null }); renderWorld(); showNotification("¡Creado un portal simple de emergencia! 🔮", "#da44ff"); } 
                                else showNotification("¡Prueba construyendo un marco de Obsidiana de 4x5!", "#da44ff");
                            }
                        } else { playSparkSound(); showNotification("¡Saltan chispas! 🔥", "#ffd700"); }
                    }
                    return;
                }

                if (type === "eye_of_ender") {
                    const blockHits = ray.intersectObjects(scene.children.filter(c => c.userData.type));
                    if (blockHits.length > 0 && blockHits[0].distance < 6) {
                        const hitObj = blockHits[0].object;
                        if (hitObj.userData.type === "end_portal_frame") {
                            const hx = hitObj.userData.x, hy = hitObj.userData.y, hz = hitObj.userData.z;
                            scene.remove(hitObj); worldData.set(`${hx},${hy},${hz}`, { type: "end_portal_frame_filled", mesh: null }); renderWorld(); playSparkSound();
                            if(!isCreative) resources.eye_of_ender--; updateInventoryUI(); tryActivateEndPortal(hx, hy, hz); return;
                        }
                    }
                    return;
                }

                const blockHits = ray.intersectObjects(scene.children.filter(c => c.userData.type));
                if (blockHits.length > 0 && blockHits[0].distance < 6) {
                    if (["pickaxe", "sword", "bow", "flint_and_steel", "apple", "meat", "beef", "chicken_meat", "mutton", "eye_of_ender"].includes(type)) return;
                    if (!isCreative) {
                        const meta = itemMetaData[type];
                        if (meta && meta.resourceName) { if (resources[meta.resourceName] <= 0) { showNotification(`Sin bloques de ${meta.name}`, "red"); return; } resources[meta.resourceName]--; } else return;
                        updateInventoryUI();
                    }
                    const pos = blockHits[0].object.position.clone().add(blockHits[0].face.normal); const roundedPos = { x: Math.round(pos.x), y: Math.round(pos.y), z: Math.round(pos.z) };
                    worldData.set(`${roundedPos.x},${roundedPos.y},${roundedPos.z}`, { type, mesh: null }); renderWorld(); playBlockSound(false); history.push({ action: 'place', x: roundedPos.x, y: roundedPos.y, z: roundedPos.z, type: type });
                }
            }
        }

        function hitFaceNormal(hit) { return hit.face.normal; }

        function animate() {
            requestAnimationFrame(animate);
            if (document.pointerLockElement) { updateCycle(); updatePlayer(); updateEntities(); }
            renderer.render(scene, camera);
        }

        window.onload = () => {
            init(); generateWorld();
            for(let i=0; i<8; i++) {
                const sx = (Math.random() - 0.5) * VIEW_DISTANCE * 1.5; const sz = (Math.random() - 0.5) * VIEW_DISTANCE * 1.5; const rand = Math.random();
                if (rand < 0.25) spawnPig(sx, 18, sz); else if (rand < 0.5) spawnCow(sx, 18, sz); else if (rand < 0.75) spawnChicken(sx, 18, sz); else spawnSheep(sx, 18, sz);
            }
            animate(); updateInventoryUI();
        };
    </script>
</body>
</html>
